---
// Har page isi layout ke andar banta hai: head, menu, footer, light/dark toggle, live effects.
import '../styles/global.css';
import { site, nav } from '../data/site';
import Socials from '../components/Socials.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.tagline } = Astro.props;
// Home: "Ascent — Aryan Jain"   Baaki pages: "Journal · Ascent"
const fullTitle = title ? `${title} · ${site.brand}` : `${site.brand} — ${site.name}`;
const path = Astro.url.pathname;
// Logo ke letters alag-alag, taaki hover par lehar (wave) chale
const first = [...'Aryan'];
const last = [...'Jain'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0b0a" />
    <!-- App icon + "Add to Home screen" support -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Brand mark "Circle Summit" (peak breaking out of a circle + climbing trail). Source: public/brand/ascent-mark.svg -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta property="og:site_name" content="Ascent" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/brand/og.png', Astro.site ?? 'https://aryanjainsoni.github.io').href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Ascent" />
    <meta name="application-name" content="Ascent" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,600;1,9..144,700;1,9..144,900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <!-- Page dikhne se pehle hi sahi theme laga do, taaki flash na ho -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      // Settings that change the look (calm mode, privacy blur, text size) — applied before paint. See src/lib/prefs.ts
      try {
        const p = JSON.parse(localStorage.getItem('pref:settings') || '{}'), r = document.documentElement;
        if (p.calm) r.classList.add('calm');
        if (p.privacy) r.classList.add('privacy');
        r.dataset.text = p.text || 'm';
      } catch {}
    </script>
  </head>
  <body>
    <div class="spotlight" aria-hidden="true"></div>

    <header class="top">
      <div class="wrap bar">
        <a class="logo" href="/" aria-label={`${site.name} — home`}>
          <span class="mark" aria-hidden="true"><span class="ring"></span><b><img src="/images/me.jpg" alt="" width="40" height="40" /></b></span>
          <span class="word" aria-hidden="true">
            {first.map((c, i) => <i style={`--i:${i}`}>{c}</i>)}<i class="gap"></i>{last.map((c, i) => <i class="sun" style={`--i:${i + 6}`}>{c}</i>)}<i class="dot" style="--i:10">.</i>
          </span>
        </a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="toggle searchbtn" href="/explore/?focus" aria-label="Search the site (press /)" title="Search  ( / or ⌘K )">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </a>
          <button id="theme-toggle" class="toggle" type="button" aria-label="Toggle light and dark mode">
            <span class="sunicon">☀️</span><span class="moon">🌙</span>
          </button>
          <button id="settings-open" class="toggle gear" type="button" aria-label="Settings" aria-haspopup="dialog" aria-controls="settings" title="Settings">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2" /><path d="M19.4 13.5a7.7 7.7 0 0 0 0-3l2-1.6-2-3.4-2.4 1a7.6 7.6 0 0 0-2.6-1.5L14 2.5h-4l-.4 2.5A7.6 7.6 0 0 0 7 6.5l-2.4-1-2 3.4 2 1.6a7.7 7.7 0 0 0 0 3l-2 1.6 2 3.4 2.4-1a7.6 7.6 0 0 0 2.6 1.5l.4 2.5h4l.4-2.5a7.6 7.6 0 0 0 2.6-1.5l2.4 1 2-3.4Z" /></svg>
          <span class="gear-dot" hidden aria-hidden="true"></span>
          </button>
        </nav>
      </div>
    </header>
    <!-- SETTINGS drawer (gear icon, top-left). Logic: src/scripts/settings.ts · Gym security/data are filled in by fit-app.ts -->
    <div class="sd-scrim" data-sd-close hidden></div>
    <aside id="settings" class="sd" role="dialog" aria-modal="true" aria-labelledby="sd-title" hidden>
      <div class="sd-head">
        <div><p class="sd-kicker">Ascent</p><h2 id="sd-title">Settings</h2></div>
        <button type="button" class="sd-x" data-sd-close aria-label="Close settings">×</button>
      </div>
      <div class="sd-body">
        <section class="sd-sec">
          <h3>Appearance</h3>
          <div class="sd-seg" role="radiogroup" aria-label="Theme">
            <button type="button" role="radio" data-theme-set="light">☀︎ Light</button>
            <button type="button" role="radio" data-theme-set="dark">☾ Dark</button>
            <button type="button" role="radio" data-theme-set="system">◐ Auto</button>
          </div>
          <div class="sd-row"><div><b>Text size</b><p>Bigger or smaller text on every page.</p></div>
            <div class="sd-seg mini" role="radiogroup" aria-label="Text size">
              <button type="button" role="radio" data-p="text" data-v="s" aria-label="Small text"><small>A</small></button>
              <button type="button" role="radio" data-p="text" data-v="m" aria-label="Medium text">A</button>
              <button type="button" role="radio" data-p="text" data-v="l" aria-label="Large text"><big>A</big></button>
            </div>
          </div>
          <div class="sd-row"><div><b>Calm mode</b><p>Every animation off — no aurora, glow, moving videos or fades.</p></div><button type="button" class="sw" role="switch" data-p="calm" aria-label="Calm mode"></button></div>
        </section>
        <section class="sd-sec">
          <h3>Sound &amp; motion</h3>
          <div class="sd-row"><div><b>Background music</b><p>Each Gym tab has its own soft instrumental.</p></div><button type="button" class="sw" role="switch" data-pref="music" aria-label="Background music"></button></div>
          <div class="sd-row"><div><b>Live video icons</b><p>Turn off to save battery and data — photos stay.</p></div><button type="button" class="sw" role="switch" data-pref="motion" aria-label="Live video icons"></button></div>
          <div class="sd-row"><div><b>Cursor glow</b><p>The soft light that follows your mouse.</p></div><button type="button" class="sw" role="switch" data-pref="glow" aria-label="Cursor glow"></button></div>
        </section>
        <section class="sd-sec" id="sd-targets">
          <h3>My targets</h3>
          <p class="sd-note">Used by the Steps ring, Today rings, Diet water &amp; protein, streaks and the Daily Log.</p>
          <div class="sd-grid">
            <label class="sd-in"><span>Steps / day</span><input type="number" inputmode="numeric" min="1000" max="50000" step="500" data-p="steps"></label>
            <label class="sd-in"><span>Sleep (hours)</span><input type="number" inputmode="decimal" min="4" max="12" step="0.25" data-p="sleep"></label>
            <label class="sd-in"><span>Water (litres)</span><input type="number" inputmode="decimal" min="1" max="8" step="0.25" data-p="water"></label>
            <label class="sd-in"><span>Protein</span><select data-p="protein">
              <option value="0">Auto (from goal)</option><option value="1.6">1.6 g / kg</option><option value="1.8">1.8 g / kg</option><option value="2">2.0 g / kg</option><option value="2.2">2.2 g / kg</option><option value="2.4">2.4 g / kg</option>
            </select></label>
            <label class="sd-in"><span>Weigh-in time</span><input type="time" data-p="weighTime"></label>
          </div>
        </section>
        <section class="sd-sec">
          <h3>Reminders</h3>
          <p class="sd-note">Pick reminders, then add them to your phone’s calendar once — it alerts you even when this site is closed.</p>
          <div class="sd-rem" data-reminders></div>
          <button type="button" class="sd-btn wide" data-ics>📅 Add to calendar (.ics)</button>
          <p class="sd-note small">Opens in Google Calendar / Apple Calendar. Re-download after changing times — import replaces the old ones.</p>
        </section>
        <section class="sd-sec">
          <h3>Units</h3>
          <div class="sd-row"><div><b>Weight</b></div><div class="sd-seg mini" role="radiogroup" aria-label="Weight unit"><button type="button" role="radio" data-p="weight" data-v="kg">kg</button><button type="button" role="radio" data-p="weight" data-v="lb">lb</button></div></div>
          <div class="sd-row"><div><b>Distance</b></div><div class="sd-seg mini" role="radiogroup" aria-label="Distance unit"><button type="button" role="radio" data-p="dist" data-v="km">km</button><button type="button" role="radio" data-p="dist" data-v="mi">mi</button></div></div>
          <div class="sd-row"><div><b>Clock</b></div><div class="sd-seg mini" role="radiogroup" aria-label="Clock"><button type="button" role="radio" data-p="clock" data-v="12">12h</button><button type="button" role="radio" data-p="clock" data-v="24">24h</button></div></div>
          <div class="sd-row"><div><b>Week starts</b></div><div class="sd-seg mini" role="radiogroup" aria-label="Week starts on"><button type="button" role="radio" data-p="weekStart" data-v="mon">Mon</button><button type="button" role="radio" data-p="weekStart" data-v="sun">Sun</button></div></div>
        </section>
        <section class="sd-sec">
          <h3>Typing</h3>
          <div class="sd-row"><div><b>Smart typing</b><p>Word suggestions and autocorrect in every text box.</p></div><button type="button" class="sw" role="switch" data-pref="typing" aria-label="Smart typing"></button></div>
          <div class="sd-row"><div><b>Learned words</b><p data-learned>Words you use often, kept in this browser.</p></div><button type="button" class="sd-btn" data-clear-words>Clear</button></div>
        </section>
        <section class="sd-sec">
          <h3>Privacy</h3>
          <div class="sd-row"><div><b>Privacy screen</b><p>Blur weights, calories and body numbers in the Gym — hover or tap to peek. Shortcut: <kbd>P</kbd></p></div><button type="button" class="sw" role="switch" data-p="privacy" aria-label="Privacy screen"></button></div>
          <div class="sd-row"><div><b>Auto-lock</b><p>Lock the Gym vault after this long in the background.</p></div>
            <select class="sd-sel" data-p="autolock" aria-label="Auto-lock after">
              <option value="1">1 min</option><option value="5">5 min</option><option value="15">15 min</option><option value="30">30 min</option><option value="0">Never</option>
            </select>
          </div>
        </section>
        <section class="sd-sec">
          <h3>Backup</h3>
          <p class="sd-note" data-backup-status>Everything in one file.</p>
          <div class="sd-btns">
            <button type="button" class="sd-btn" data-backup>⬇ Full backup</button>
            <label class="sd-btn file">⬆ Restore<input type="file" accept=".json,application/json" data-restore hidden></label>
          </div>
          <p class="sd-note small">Gym (stays encrypted), goal ticks, Daily Log drafts, learned words and these settings.</p>
        </section>
        <section class="sd-sec">
          <h3>App</h3>
          <div class="sd-row"><div><b>Install Ascent</b><p data-install-note>Opens like an app, full screen, from your home screen.</p></div><button type="button" class="sd-btn" data-install>Install</button></div>
          <div class="sd-row"><div><b>Offline mode</b><p data-offline-note>Pages you’ve opened work without internet.</p></div><span class="sd-pill" data-offline-pill>…</span></div>
          <div class="sd-row"><div><b>Keyboard shortcuts</b><p>Jump anywhere without the mouse.</p></div><button type="button" class="sd-btn" data-shortcuts>Show <kbd>?</kbd></button></div>
        </section>
        <section class="sd-sec">
          <h3>Security &amp; data</h3>
          <div data-sd-gym data-fit="settings"><p class="sd-note">Loading…</p></div>
        </section>
      </div>
    </aside>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap foot">
        <p class="sign">Built in public, <em class="sun">one day at a time.</em></p>
        <div class="row">
          <span class="muted">© {new Date().getFullYear()} {site.name}</span>
          <Socials size="sm" />
        </div>
      </div>
    </footer>

    <script is:inline>
      // Search shortcut: "/" ya Cmd/Ctrl+K -> Index page ka search (typing ke beech nahi)
      addEventListener('keydown', (e) => {
        const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName || '') || document.activeElement?.isContentEditable;
        const isK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
        if (!(isK || (e.key === '/' && !typing))) return;
        e.preventDefault();
        const q = document.getElementById('q');
        if (q) { q.focus(); q.select(); } else { location.href = '/explore/?focus'; }
      });

      // Light / dark toggle
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        dispatchEvent(new Event('ascent:theme'));
      });

      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('calm'); // Settings → Calm mode
      const finePointer = matchMedia('(pointer: fine)').matches;

      // Scroll par elements ka aana.
      // Safety: JS na chale to sab dikhta hai; screen par jo hai wo turant aata hai;
      // aur agar observer kabhi fire hi na ho to 2 second baad sab dikha do.
      const revealEls = [...document.querySelectorAll('[data-reveal]')];
      if (!calm && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-ready');
        let fired = false;
        const io = new IntersectionObserver((items) => {
          fired = true;
          items.forEach((it) => {
            if (it.isIntersecting) { it.target.classList.add('in'); io.unobserve(it.target); }
          });
        }, { threshold: 0.12 });
        revealEls.forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) requestAnimationFrame(() => el.classList.add('in'));
          else io.observe(el);
        });
        setTimeout(() => { if (!fired) revealEls.forEach((el) => el.classList.add('in')); }, 2000);
      }

      if (!calm && finePointer && localStorage.getItem('pref:glow') !== 'off') {
        // Cursor ke saath glow
        const root = document.documentElement;
        addEventListener('pointermove', (e) => {
          root.style.setProperty('--mx', e.clientX + 'px');
          root.style.setProperty('--my', e.clientY + 'px');
          root.classList.add('glow-on');
        }, { passive: true });
        document.documentElement.addEventListener('mouseleave', () => root.classList.remove('glow-on'));
        addEventListener('blur', () => root.classList.remove('glow-on'));
      }
    </script>
      <script>
      import '../scripts/smart-type.ts'; // word suggestions + autocorrect in every text box
      import '../scripts/settings.ts'; // settings drawer (gear icon)
      import '../scripts/shortcuts.ts'; // keyboard shortcuts + cheat sheet (press ?)
      import '../scripts/pwa.ts'; // install button + offline mode (service worker)
    </script>
</body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 16px; }
  /* ===== Logo: AJ badge + wave wordmark ===== */
  .logo { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); }
  .logo:hover { text-decoration: none; }

  .mark { position: relative; display: grid; place-items: center; width: 54px; height: 54px; flex-shrink: 0; }
  .mark b {
    position: relative; z-index: 1; display: grid; place-items: center;
    width: 46px; height: 46px; border-radius: 50%;
    background: var(--sun); overflow: hidden;
    box-shadow: 0 6px 18px -6px var(--accent-2);
    transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
  }
  .mark img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  /* Badge ke chaaron taraf ghoomti gradient ring */
  .ring {
    position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 0deg, #ff8a3d, #ff2e7e, transparent 55%, #ff8a3d);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2.5px), #000 calc(100% - 2px));
            mask: radial-gradient(farthest-side, transparent calc(100% - 2.5px), #000 calc(100% - 2px));
    opacity: .9;
  }
  .logo:hover .mark b { transform: scale(1.12); }

  .word { display: inline-flex; align-items: baseline; font: 900 26px/1 'Fraunces', serif; letter-spacing: -0.03em; }
  .word i { display: inline-block; font-style: normal; }
  /* italic letters ka swash gradient se kate nahi — thodi extra jagah */
  .word .sun { font-style: italic; padding: 0.1em 0.08em 0.2em 0.12em; margin: -0.1em -0.08em -0.2em -0.12em; }
  .word .gap { width: 0.28em; }
  .word .dot { color: var(--accent-2); }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes wave { 40% { transform: translateY(-7px) rotate(-4deg); } 100% { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .ring, .logo:hover .word i { animation: none; }
    .logo:hover .mark b { transform: none; }
  }
  nav { display: flex; align-items: center; gap: 22px; }
  nav a { position: relative; color: var(--muted); font-size: 14px; font-weight: 500; }
  nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: var(--sun); border-radius: 2px; transform: scaleX(0); transition: transform 0.25s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); text-decoration: none; }
  nav a:hover::after, nav a[aria-current='page']::after { transform: scaleX(1); }
  .toggle {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 999px;
    width: 38px;
    height: 38px;
    cursor: pointer;
    font-size: 16px;
    transition: transform 0.3s;
  }
  .toggle:hover { transform: rotate(20deg); }
  .searchbtn { display: grid; place-items: center; color: var(--ink); }
  .searchbtn:hover { transform: scale(1.08); border-color: var(--accent); }
  .searchbtn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
  .toggle .moon { display: none; }
  :global(:root[data-theme='dark']) .toggle .sunicon { display: none; }
  :global(:root[data-theme='dark']) .toggle .moon { display: inline; }

  footer { border-top: 1px solid var(--line); padding-block: 56px 32px; margin-top: 40px; }
  .sign { font: 700 clamp(1.8rem, 5vw, 3rem)/1.1 'Fraunces', serif; margin: 0 0 32px; letter-spacing: -0.02em; }
  .row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; font-size: 14px; }

  @media (max-width: 420px) { .word { display: none; } }
  @media (max-width: 480px) {
    .bar { padding-inline: 16px; gap: 10px; }
    .word { font-size: 21px; }
    .mark { width: 46px; height: 46px; }
    .mark b { width: 39px; height: 39px; }
    nav { gap: 12px; }
    nav > a:first-child { display: none; } /* Home — logo already links home */
    #theme-toggle { display: none; } /* theme lives in Settings on phones */
    nav a[href="/explore/"] { display: none; } /* the search icon opens the Index */
    .toggle { width: 34px; height: 34px; font-size: 14px; flex-shrink: 0; }
  }
</style>
