---
// Social links ko unke asli logos aur asli brand colours ke saath dikhata hai.
// Logos: simple-icons (GitHub, LeetCode, Instagram, X) + bootstrap-icons (LinkedIn).
import { siGithub, siLeetcode, siInstagram, siX } from 'simple-icons';
import linkedinSvg from 'bootstrap-icons/icons/linkedin.svg?raw';
import { links } from '../data/site';

interface Props {
  size?: 'lg' | 'sm';
}
const { size = 'lg' } = Astro.props;
const gid = `ig-${size}`; // Instagram gradient ka id

const linkedinPath = linkedinSvg.match(/ d="([^"]+)"/)![1];
const IG = 'linear-gradient(45deg, #feda75, #fa7e1e 25%, #d62976 50%, #962fbf 75%, #4f5bd5)';

// fg = logo ka rang, bg = hover par button ka rang.
// GitHub aur X ka asli rang black hai — dark mode mein wo white dikhenge (warna gayab ho jate).
const icons: Record<string, { path: string; box: string; fg: string; bg: string }> = {
  GitHub: { path: siGithub.path, box: '0 0 24 24', fg: 'var(--mono)', bg: 'var(--mono)' },
  LinkedIn: { path: linkedinPath, box: '0 0 16 16', fg: '#0a66c2', bg: '#0a66c2' },
  LeetCode: { path: siLeetcode.path, box: '0 0 24 24', fg: `#${siLeetcode.hex}`, bg: `#${siLeetcode.hex}` },
  Instagram: { path: siInstagram.path, box: '0 0 24 24', fg: `url(#${gid})`, bg: IG },
  X: { path: siX.path, box: '0 0 24 24', fg: 'var(--mono)', bg: 'var(--mono)' },
};
---
<div class:list={['socials', size]}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#feda75" />
        <stop offset=".25" stop-color="#fa7e1e" />
        <stop offset=".5" stop-color="#d62976" />
        <stop offset=".75" stop-color="#962fbf" />
        <stop offset="1" stop-color="#4f5bd5" />
      </linearGradient>
    </defs>
  </svg>
  {links.map((l) => {
    const i = icons[l.label];
    return (
      <a
        href={l.href}
        target="_blank"
        rel="noopener"
        aria-label={l.label}
        title={l.label}
        class={l.label.toLowerCase()}
        style={i ? `--fg:${i.fg};--bg:${i.bg}` : undefined}
      >
        {i ? <svg viewBox={i.box} aria-hidden="true"><path d={i.path} /></svg> : l.label}
      </a>
    );
  })}
</div>

<style>
  .socials { --mono: #181717; display: flex; flex-wrap: wrap; gap: 10px; }
  :global(:root[data-theme='dark']) .socials { --mono: #ffffff; }

  a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(6px);
    transition: transform 0.25s cubic-bezier(.2,.7,.2,1), background 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  svg { width: 22px; height: 22px; fill: var(--fg); transition: fill 0.25s; }

  a:hover {
    text-decoration: none;
    background: var(--bg);
    border-color: transparent;
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.5);
  }
  a:hover svg { fill: #fff; }
  /* GitHub / X: hover par ulte rang (light mein black button, dark mein white button) */
  a.github:hover svg, a.x:hover svg { fill: var(--surface); }

  .sm a { width: 38px; height: 38px; }
  .sm svg { width: 17px; height: 17px; }
</style>
