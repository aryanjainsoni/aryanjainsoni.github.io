---
// Social links ko unke asli logos ke saath dikhata hai.
// Logos: simple-icons (GitHub, LeetCode, Instagram, X) + bootstrap-icons (LinkedIn).
import { siGithub, siLeetcode, siInstagram, siX } from 'simple-icons';
import linkedinSvg from 'bootstrap-icons/icons/linkedin.svg?raw';
import { links } from '../data/site';

interface Props {
  size?: 'lg' | 'sm';
}
const { size = 'lg' } = Astro.props;

const linkedinPath = linkedinSvg.match(/ d="([^"]+)"/)![1];
const icons: Record<string, { path: string; box: string; color: string }> = {
  GitHub: { path: siGithub.path, box: '0 0 24 24', color: '#6e5494' },
  LinkedIn: { path: linkedinPath, box: '0 0 16 16', color: '#0a66c2' },
  LeetCode: { path: siLeetcode.path, box: '0 0 24 24', color: `#${siLeetcode.hex}` },
  Instagram: { path: siInstagram.path, box: '0 0 24 24', color: '#e1306c' },
  X: { path: siX.path, box: '0 0 24 24', color: '#111111' },
};
---
<div class:list={['socials', size]}>
  {links.map((l) => {
    const i = icons[l.label];
    return (
      <a href={l.href} target="_blank" rel="noopener" aria-label={l.label} title={l.label} style={`--brand:${i?.color ?? 'var(--accent)'}`}>
        {i ? (
          <svg viewBox={i.box} aria-hidden="true"><path d={i.path} /></svg>
        ) : (
          l.label
        )}
      </a>
    );
  })}
</div>

<style>
  .socials { display: flex; flex-wrap: wrap; gap: 10px; }
  a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--ink);
    backdrop-filter: blur(6px);
    transition: transform 0.25s cubic-bezier(.2,.7,.2,1), background 0.25s, border-color 0.25s, color 0.25s, box-shadow 0.25s;
  }
  a:hover {
    text-decoration: none;
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 12px 24px -10px var(--brand);
  }
  svg { width: 20px; height: 20px; fill: currentColor; }
  .sm a { width: 38px; height: 38px; }
  .sm svg { width: 16px; height: 16px; }
</style>
