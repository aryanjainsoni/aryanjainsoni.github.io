---
// Ek section ka visual card. Agar public/images/covers/<slug>.jpg (ya .png/.webp) maujood hai
// to wahi photo lagegi, warna gradient + emoji wala design.
import { existsSync } from 'node:fs';

interface Props {
  topic: {
    slug: string; title: string; line: string; href: string; ready: boolean;
    external?: boolean; emoji: string; art: string[]; size?: string;
  };
  delay?: number;
}
const { topic, delay = 0 } = Astro.props;
const photo = ['jpg', 'jpeg', 'png', 'webp']
  .map((ext) => `/images/covers/${topic.slug}.${ext}`)
  .find((p) => existsSync(`public${p}`));
const Tag = topic.ready ? 'a' : 'div';
---
<Tag
  class:list={['topic', topic.size, { soon: !topic.ready }]}
  href={topic.ready ? topic.href : undefined}
  target={topic.external ? '_blank' : undefined}
  rel={topic.external ? 'noopener' : undefined}
  style={`--a:${topic.art[0]};--b:${topic.art[1]};--d:${delay}s`}
  data-reveal
>
  <div class="cover">
    {photo ? (
      <img src={photo} alt={topic.title} loading="lazy" />
    ) : (
      <>
        <span class="ring r1" /><span class="ring r2" /><span class="grain" />
        <span class="emoji" aria-hidden="true">{topic.emoji}</span>
      </>
    )}
  </div>
  <div class="text">
    <h3>{topic.title}{!topic.ready && <span class="badge">soon</span>}{topic.external && <span class="arrow">↗</span>}</h3>
    <p>{topic.line}</p>
  </div>
</Tag>

<style>
  .topic {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    color: var(--ink);
    min-height: 280px;
  }
  .topic:hover { text-decoration: none; }
  .wide { grid-column: span 2; }

  .cover {
    position: relative;
    flex: 1;
    min-height: 180px;
    background: linear-gradient(135deg, var(--a), var(--b));
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
  .topic:hover .cover img { transform: scale(1.06); }

  .emoji {
    font-size: 76px;
    filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.25));
    position: relative;
    transition: transform 0.4s cubic-bezier(.2,.7,.2,1);
  }
  .topic:hover .emoji { transform: scale(1.06); }

  .ring { position: absolute; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.28); }
  .r1 { width: 260px; height: 260px; right: -70px; top: -90px; }
  .r2 { width: 140px; height: 140px; left: -40px; bottom: -50px; background: rgba(255, 255, 255, 0.1); border: none; }
  .grain {
    position: absolute; inset: 0; opacity: 0.18; mix-blend-mode: overlay;
    background-image: radial-gradient(rgba(255,255,255,.8) 1px, transparent 1px);
    background-size: 6px 6px;
  }
  .glare {
    position: absolute; inset: 0; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(400px circle at var(--gx, 50%) var(--gy, 50%), rgba(255, 255, 255, 0.35), transparent 50%);
  }
  .topic:hover .glare { opacity: 1; }

  .text { padding: 16px 20px 20px; }
  h3 { font-size: 1.45rem; margin: 0 0 4px; display: flex; align-items: center; gap: 8px; }
  p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .badge { font: 500 10px 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 3px 8px; }
  .arrow { color: var(--accent); font-size: 1.1rem; }
  .soon .cover { filter: saturate(0.85); }

  @media (max-width: 720px) {
    .wide { grid-column: auto; }
    .topic { min-height: 240px; }
  }
</style>
