---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getEntries } from '../../lib/journal';

// Har entry ke liye ek page banao: /journal/2026-11-27/
export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toLocaleDateString('en-IN', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---
<Base title={entry.data.title} description={`Journal — ${date}`}>
  <article class="wrap entry">
    <a class="back" href="/journal/">← All entries</a>
    <p class="kicker">{date}</p>
    <h1>{entry.data.title}</h1>
    <div class="meta">
      {entry.data.tags.map((t) => <span class="pill">{t}</span>)}
      {entry.data.dsaSolved > 0 && <span class="pill dsa">🧩 {entry.data.dsaSolved} DSA solved</span>}
    </div>
    <div class="prose"><Content /></div>
    <nav class="pager" aria-label="More entries">
      {older ? <a class="card" href={`/journal/${older.id}/`}><span class="muted">← Older</span>{older.data.title}</a> : <span />}
      {newer ? <a class="card right" href={`/journal/${newer.id}/`}><span class="muted">Newer →</span>{newer.data.title}</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .entry { max-width: 760px; padding-block: 56px 72px; }
  .back { font-size: 14px; color: var(--muted); }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 10px 0 14px; }
  .kicker { margin-top: 28px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .dsa { background: color-mix(in srgb, var(--green) 18%, transparent); color: var(--green); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 48px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; color: var(--ink); font-weight: 600; }
  .pager a:hover { text-decoration: none; border-color: var(--accent); }
  .pager .right { text-align: right; }
  .pager span.muted { font-size: 13px; font-weight: 500; }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } }
</style>
