---
// DAILY LOG — answer a few questions, get a ready journal entry, publish it to GitHub in one click.
// Questions live in src/data/dailyLog.ts (edit there to evolve the form).
// Drafts are saved in this browser only. Nothing is published until you press Commit on GitHub.
import Base from '../layouts/Base.astro';
import { dailyLog, repo } from '../data/dailyLog';
import { getEntries } from '../lib/journal';
import { getLeetCode } from '../lib/leetcode';
import { goals } from '../data/profile';

const existing = (await getEntries()).map((e) => e.id);
// LeetCode submissions per day (last 60 days, as of the last site build) — used by the auto-drafted reflection
const lc = await getLeetCode();
const since = new Date(Date.now() - 60 * 864e5).toISOString().slice(0, 10);
const leet = lc ? Object.fromEntries([...lc.byDay].filter(([d]) => d >= since)) : {};
const all = dailyLog.flatMap((s) => s.questions);
// Chhote icons multi-select options ke liye (apne design — LinkedIn ke official art nahi)
const icons: Record<string, string> = {
  Zip: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="1" width="22" height="22" rx="6" fill="#ff7a45"/><path d="M6 7h12v5H6v5h12" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="7" r="2.2" fill="#1c1512"/><circle cx="18" cy="17" r="2.2" fill="#1c1512"/></svg>',
  Patches: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="1" width="22" height="22" rx="6" fill="#1c1512"/><rect x="4" y="4" width="9" height="7" rx="1.5" fill="#f9c74f"/><rect x="14" y="4" width="6" height="11" rx="1.5" fill="#43aa8b"/><rect x="4" y="12" width="9" height="8" rx="1.5" fill="#f3722c"/><rect x="14" y="16" width="6" height="4" rx="1.5" fill="#577590"/></svg>',
};
---
<Base title="Daily Log" description="Aryan's daily log — a few questions that turn into today's journal entry.">
  <section class="head">
    <div class="wrap">
      <p class="kicker">Daily Log</p>
      <h1>Five minutes, <em>every night.</em></h1>
      <p class="lead">Answer what you can — skip the rest. Your answers become today’s journal entry, ready to publish.</p>
      <div class="bar">
        <label class="pick"><span>Entry for</span><input type="date" id="date" /></label>
        <span class="saved" id="saved" aria-live="polite">Draft saves automatically</span>
        <span class="progress" id="progress">0 answered</span>
      </div>
      <p class="drafts" id="drafts" hidden></p>
      <p class="warn" id="exists" hidden>An entry for this date is already published. Publishing again opens GitHub’s editor for that file — paste the new text there (it’s copied for you).</p>
    </div>
  </section>

  <section class="body">
    <div class="wrap layout">
      <form class="form" id="form" autocomplete="off" onsubmit="return false">
        {dailyLog.map((s, si) => (
          <fieldset class="card sec">
            <legend><span class="n">{String(si + 1).padStart(2, '0')}</span>{s.title}</legend>
            <p class="intro">{s.intro}</p>
            {s.questions.map((q) => (
              <div class="q" data-q={q.id}>
                <label class="ql" for={`f-${q.id}`}>
                  {q.label}{q.required && <span class="req" title="Recommended">•</span>}{q.private && <span class="lock">🔒 private</span>}
                </label>
                {q.hint && <p class="hint">{q.hint}</p>}
                {q.type === 'text' && <input id={`f-${q.id}`} name={q.id} type="text" />}
                {(q.type === 'long' || q.type === 'list') && <textarea id={`f-${q.id}`} name={q.id} rows={q.type === 'list' ? 3 : 2} placeholder={q.type === 'list' ? 'One per line' : ''}></textarea>}
                {q.auto && q.auto !== 'github' && <div class="auto"><span class="ad" id={`ad-${q.id}`}>auto</span><button type="button" class="link" data-redraft={q.id}>⟳ Re-draft</button></div>}
                {q.auto === 'github' && <div class="auto"><button type="button" class="link" id="gh-fetch">⟳ Fetch from GitHub</button><span id="gh-status" aria-live="polite"></span></div>}
                {q.type === 'number' && <span class="num"><input id={`f-${q.id}`} name={q.id} type="number" min="0" step={q.step ?? 0.5} inputmode={q.step === 1 ? "numeric" : "decimal"} />{q.unit && <em>{q.unit}</em>}</span>}
                {q.type === 'rate' && (
                  <div class="rate" role="radiogroup" aria-label={q.label} id={`f-${q.id}`}>
                    {[1, 2, 3, 4, 5].map((v) => <label><input type="radio" name={q.id} value={v} /><span>{v}</span></label>)}
                  </div>
                )}
                {q.type === 'multi' && (
                  <div class="chips multi" role="group" aria-label={q.label} id={`f-${q.id}`}>
                    {q.options!.map((o) => <label><input type="checkbox" name={q.id} value={o} /><span>{icons[o] && <i class="ico" set:html={icons[o]} />}{o}</span></label>)}
                  </div>
                )}
                {q.type === 'choice' && (
                  <div class="chips" role="radiogroup" aria-label={q.label} id={`f-${q.id}`}>
                    {q.options!.map((o) => <label><input type="radio" name={q.id} value={o} /><span>{o}</span></label>)}
                  </div>
                )}
              </div>
            ))}
          </fieldset>
        ))}
        <button type="button" class="link danger" id="clear">Clear this day’s draft</button>
      </form>

      <aside class="side">
        <div class="card preview">
          <p class="label">Preview</p>
          <div class="md" id="preview"><p class="muted">Start answering — your entry appears here.</p></div>
          <div class="actions">
            <button type="button" class="btn primary" id="publish">Publish to GitHub ↗</button>
            <div class="row2">
              <button type="button" class="btn ghost sm" id="copy">Copy text</button>
              <button type="button" class="btn ghost sm" id="download">Download .md</button>
            </div>
            <p class="fine" id="msg" aria-live="polite">Publish opens GitHub with your entry filled in — just press <b>Commit changes</b>. The site updates in ~1 minute.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script type="application/json" id="log-config" set:html={JSON.stringify({ questions: all, repo, existing, leet, goals })} />

  <script is:inline>
    (() => {
      const CFG = JSON.parse(document.getElementById('log-config').textContent);
      const Q = CFG.questions;
      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const form = $('#form'), dateIn = $('#date');
      const pad = (n) => String(n).padStart(2, '0');
      const ymd = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      const today = ymd(new Date());
      dateIn.max = today;
      dateIn.value = /^\d{4}-\d{2}-\d{2}$/.test(new URLSearchParams(location.search).get('date') || '') ? new URLSearchParams(location.search).get('date') : today;

      const key = () => `log:draft:${dateIn.value}`;
      const read = () => {
        const v = {};
        Q.forEach((q) => {
          if (q.type === 'rate' || q.type === 'choice') { const c = form.querySelector(`input[name="${q.id}"]:checked`); v[q.id] = c ? c.value : ''; }
          else if (q.type === 'multi') v[q.id] = [...form.querySelectorAll(`input[name="${q.id}"]:checked`)].map((c) => c.value).join(', ');
          else v[q.id] = (form.elements[q.id]?.value || '').trim();
        });
        return v;
      };
      const write = (v) => {
        Q.forEach((q) => {
          if (q.type === 'rate' || q.type === 'choice') $$(`input[name="${q.id}"]`, form).forEach((r) => (r.checked = r.value === String(v[q.id] ?? '')));
          else if (q.type === 'multi') $$(`input[name="${q.id}"]`, form).forEach((r) => (r.checked = String(v[q.id] ?? '').split(', ').includes(r.value)));
          else if (form.elements[q.id]) form.elements[q.id].value = v[q.id] ?? '';
        });
      };

      // Goals page ke aaj ke ticks (same browser) — entry mein "Goals 9/13" ke liye
      const goalsLine = () => {
        try {
          const ticks = JSON.parse(localStorage.getItem(`goals:${dateIn.value}`) || '{}');
          const cfg = JSON.parse(localStorage.getItem('goals:config') || 'null');
          const n = Object.values(ticks).filter(Boolean).length;
          if (!n) return '';
          const total = cfg?.daily?.length || 13;
          return `Goals ${Math.min(n, total)}/${total}`;
        } catch { return ''; }
      };

      const toMarkdown = (v) => {
        const steps = () => { const n = Math.round(Number(v.steps)); return Number.isFinite(n) && n > 0 ? n : 0; };
        const tags = [...new Set(Q.filter((q) => q.tag && v[q.id] && !['Skipped', 'Not today', 'Rest day'].includes(v[q.id])).map((q) => q.tag))];
        const title = (v.headline || 'Daily log').replace(/"/g, '\\"');
        const meta = [
          v.mood && `**Mood** ${v.mood}/5`, v.energy && `**Energy** ${v.energy}/5`, v.sleep && `**Sleep** ${v.sleep}h`,
          steps() && `**Steps** ${steps().toLocaleString('en-IN')}`,
          goalsLine() && `**${goalsLine()}**`,
        ].filter(Boolean).join(' · ');
        const bullets = (out) => Q.filter((q) => q.out === out && v[q.id] && !q.private && v[q.id] !== 'Not today').flatMap((q) => {
          if (q.type === 'list') return v[q.id].split('\n').map((l) => l.trim()).filter(Boolean).map((l) => `- ${q.prefix ? `**${q.prefix}:** ` : ''}${l}`);
          return [`- ${q.prefix ? `**${q.prefix}:** ` : ''}${v[q.id].replace(/\n+/g, ' ')}`];
        });
        const parts = [`---\ntitle: "${title}"\ndate: ${dateIn.value}\ntags: [${(tags.length ? tags : ['journal']).join(', ')}]${steps() ? `\nsteps: ${steps()}` : ''}\n---\n`];
        if (meta) parts.push(meta + '\n');
        const L = bullets('learned'), D = bullets('did'), R = bullets('reflect'), T = bullets('tomorrow').map((l) => l.replace(/^- \*\*[^*]+\*\* /, '- '));
        if (L.length) parts.push('## What I learned\n\n' + L.join('\n') + '\n');
        if (D.length) parts.push('## What I did today\n\n' + D.join('\n') + '\n');
        if (R.length) parts.push('## Reflection\n\n' + R.join('\n') + '\n');
        if (T.length) parts.push('## Tomorrow\n\n' + T.join('\n') + '\n');
        return parts.join('\n');
      };

      // tiny markdown -> HTML for the preview
      const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
      const inline = (s) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/`(.+?)`/g, '<code>$1</code>');
      const render = (md) => {
        const [, fm = '', body = ''] = md.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/) || [];
        const title = (fm.match(/title: "(.*)"/) || [])[1] || '';
        const tags = ((fm.match(/tags: \[(.*)\]/) || [])[1] || '').split(',').map((t) => t.trim()).filter(Boolean);
        let html = `<p class="pdate">${dateIn.value}</p><h3 class="ptitle">${esc(title.replace(/\\"/g, '"'))}</h3><p class="ptags">${tags.map((t) => `<i>${esc(t)}</i>`).join('')}</p>`;
        let inList = false;
        body.split('\n').forEach((line) => {
          if (line.startsWith('- ')) { if (!inList) { html += '<ul>'; inList = true; } html += `<li>${inline(line.slice(2))}</li>`; return; }
          if (inList) { html += '</ul>'; inList = false; }
          if (line.startsWith('## ')) html += `<h4>${inline(line.slice(3))}</h4>`;
          else if (line.trim()) html += `<p>${inline(line)}</p>`;
        });
        if (inList) html += '</ul>';
        return html;
      };

      // ---------- AUTO-DRAFT: win / hard / tomorrow from the day's data ----------
      // A field keeps updating itself while it still equals the last auto text. The moment you edit it, it's yours.
      let autoMem = {};            // id -> last auto text (saved with the draft as "_auto")
      const ghData = {};           // date -> { n, repos: [[name, count, [msgs]]] }
      const DAYS = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      const fmt12 = (t) => { if (!t) return ''; const [h, m] = t.split(':').map(Number); return `${((h + 11) % 12) + 1}:${pad(m)} ${h < 12 ? 'AM' : 'PM'}`; };
      const isoWeek = (ds) => { const d = new Date(ds + 'T00:00:00Z'); const day = (d.getUTCDay() + 6) % 7; d.setUTCDate(d.getUTCDate() - day + 3); const y = d.getUTCFullYear(); const jan4 = new Date(Date.UTC(y, 0, 4)); const w = 1 + Math.round(((d - jan4) / 864e5 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7); return `${y}-W${pad(w)}`; };
      const addDay = (ds, n) => { const d = new Date(ds + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };
      const goalsCfg = () => { try { const c = JSON.parse(localStorage.getItem('goals:config') || 'null'); if (c?.daily) return c; } catch {} return CFG.goals; };
      const cut = (s, n = 70) => (s.length > n ? s.slice(0, n - 1).trimEnd() + '…' : s);
      const drafts = (v) => {
        const d = dateIn.value, gh = ghData[d], lcN = CFG.leet[d] || 0, cfg = goalsCfg();
        let ticks = {}; try { ticks = JSON.parse(localStorage.getItem(`goals:${d}`) || '{}'); } catch {}
        const daily = cfg.daily || [], done = daily.filter((g) => ticks[g.id]), missed = daily.filter((g) => !ticks[g.id]);
        const goalsLogged = Object.keys(ticks).length > 0;
        const dsaN = (v.dsa || '').split('\n').filter((l) => l.trim()).length || 0;
        const sleep = parseFloat(v.sleep), steps = parseFloat(v.steps), energy = Number(v.energy), mood = Number(v.mood);
        const trained = v.gym && !['Skipped', 'Rest day'].includes(v.gym);
        // WIN — strongest 2 things that happened
        const wins = [];
        if (gh?.n) wins.push([Math.min(30, gh.n * 2), `Shipped ${gh.n} commit${gh.n > 1 ? 's' : ''} to ${gh.repos.map((r) => r[0]).join(', ')} — ${cut(gh.repos[0][2].slice(-1)[0] || '')}`]);
        if (v.gymNote) wins.push([25, `Gym: ${v.gymNote}`]); else if (trained) wins.push([8, `Trained ${v.gym.toLowerCase()}`]);
        if (dsaN || lcN) wins.push([Math.max(dsaN, 1) * 6, dsaN ? `Solved ${dsaN} LeetCode problem${dsaN > 1 ? 's' : ''}` : `Kept LeetCode going (${lcN} submission${lcN > 1 ? 's' : ''})`]);
        if (goalsLogged && done.length >= daily.length * 0.8) wins.push([20, `Hit ${done.length}/${daily.length} daily goals`]);
        if (steps >= 10000) wins.push([10, `${Math.round(steps).toLocaleString('en-IN')} steps`]);
        if (v.vedantu) wins.push([6, `Learned: ${cut(v.vedantu, 60)}`]);
        const win = wins.sort((a, b) => b[0] - a[0]).slice(0, 2).map((w) => w[1]).join('; ');
        // HARD — honest list of what slipped
        const hard = [];
        if (goalsLogged && missed.length) hard.push(`Missed ${missed.slice(0, 3).map((g) => g.name).join(', ')}${missed.length > 3 ? ` +${missed.length - 3} more` : ''}`);
        if (sleep && sleep < 7) hard.push(`only ${sleep}h sleep`);
        if (v.diet === 'Off track' || v.diet === 'Mostly') hard.push(`diet ${v.diet.toLowerCase()}`);
        if (v.gym === 'Skipped') hard.push('skipped the gym');
        if (steps && steps < 7000) hard.push(`only ${Math.round(steps).toLocaleString('en-IN')} steps`);
        if ((energy && energy <= 2) || (mood && mood <= 2)) hard.push(`low ${energy && energy <= 2 ? 'energy' : 'mood'}`);
        if (!dsaN && !lcN) hard.push('no LeetCode today');
        const hardTxt = hard.length ? hard.join('; ').replace(/^./, (c) => c.toUpperCase()) + '.' : '';
        // TOMORROW — missed daily goals first, then tomorrow's weekly tasks, then the streak keepers
        const t = addDay(d, 1), tDay = DAYS[new Date(t + 'T00:00:00Z').getUTCDay()], wk = isoWeek(t);
        let wt = {}; try { wt = JSON.parse(localStorage.getItem(`goals:${wk}`) || '{}'); } catch {}
        const weeklyDue = (cfg.weekly || []).filter((w) => (w.days || []).includes(tDay) && Object.keys(wt).filter((k) => k.startsWith(w.id + '@') && wt[k]).length < (Number(w.target) || 1));
        const label = (g) => g.name + (g.time ? ` · ${fmt12(g.time)}` : '');
        const picks = [...(goalsLogged ? missed : []).map(label), ...weeklyDue.map(label), '1 LeetCode question', 'GitHub commit', 'Gym · 5:30 PM'];
        const tomorrow = [...new Set(picks)].slice(0, 3).join('\n');
        return { win, hard: hardTxt, tomorrow };
      };
      const applyAuto = () => {
        const v = read(), a = drafts(v);
        Object.keys(a).forEach((id) => {
          const el = form.elements[id]; if (!el) return;
          const mine = el.value.trim() && el.value !== (autoMem[id] ?? '');
          const badge = $(`#ad-${id}`);
          if (!mine) { el.value = a[id]; autoMem[id] = a[id]; }
          if (badge) { badge.textContent = mine ? 'your words ✓' : a[id] ? 'auto · updates as your day fills' : 'auto · fills in as you log'; badge.classList.toggle('mine', !!mine); }
        });
      };
      $$('[data-redraft]').forEach((b) => b.addEventListener('click', () => { const id = b.dataset.redraft, el = form.elements[id]; if (el.value.trim() && el.value !== autoMem[id] && !confirm('Replace your text with a fresh auto-draft?')) return; el.value = ''; autoMem[id] = ''; update(); }));

      let md = '';
      const stamp = () => new Date().toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
      const update = (persist = true) => {
        applyAuto();
        const v = read();
        if (persist) { try { localStorage.setItem(key(), JSON.stringify({ ...v, _auto: autoMem, _saved: Date.now() })); $('#saved').textContent = `Saved ✓ ${stamp()}`; } catch {} }
        const answered = Q.filter((q) => v[q.id]).length;
        $('#progress').textContent = `${answered} of ${Q.length} answered`;
        md = toMarkdown(v);
        $('#preview').innerHTML = answered ? render(md) : '<p class="muted">Start answering — your entry appears here.</p>';
        $$('.q', form).forEach((el) => el.classList.toggle('filled', !!v[el.dataset.q]));
        $('#exists').hidden = !CFG.existing.includes(dateIn.value);
      };
      // GitHub -> "what did you commit" (public commits by date, IST). Never overwrites what you typed unless you press ⟳.
      const ghStatus = (t) => { const el = $('#gh-status'); if (el) el.textContent = t; };
      const ghFetch = async (force) => {
        const el = form.elements['github']; if (!el) return;
        if (!force && el.value.trim() && ghData[dateIn.value]) return;
        const d = dateIn.value, q = `author:${CFG.repo.owner} author-date:${d}T00:00:00+05:30..${d}T23:59:59+05:30`;
        ghStatus('Fetching your commits…');
        try {
          const r = await fetch(`https://api.github.com/search/commits?q=${encodeURIComponent(q)}&sort=author-date&order=asc&per_page=100`, { headers: { Accept: 'application/vnd.github+json' } });
          if (!r.ok) throw new Error(String(r.status));
          const j = await r.json();
          if (d !== dateIn.value) return; // date changed while loading
          const items = (j.items || []).filter((i) => !/^Merge /.test(i.commit.message));
          if (!items.length) { ghData[d] = { n: 0, repos: [] }; ghStatus(`No public commits on ${d}.`); update(); return; }
          const byRepo = new Map();
          items.forEach((i) => { const name = i.repository.name, line = i.commit.message.split('\n')[0].trim(); const list = byRepo.get(name) || []; if (!list.includes(line)) list.push(line); byRepo.set(name, list); });
          const count = (name) => items.filter((i) => i.repository.name === name).length;
          const text = [...byRepo].map(([name, msgs]) => `${name} (${count(name)} commit${count(name) > 1 ? 's' : ''}): ${msgs.slice(0, 8).join('; ')}${msgs.length > 8 ? `; +${msgs.length - 8} more` : ''}`).join('\n');
          ghData[d] = { n: items.length, repos: [...byRepo].map(([name, msgs]) => [name, count(name), msgs]) };
          if (!force && el.value.trim()) { ghStatus(`✓ ${items.length} commits found — box already has your text`); update(); return; } // you started typing meanwhile
          el.value = text; el.dispatchEvent(new Event('input', { bubbles: true }));
          ghStatus(`✓ ${items.length} commit${items.length > 1 ? 's' : ''} from GitHub · edit freely`);
        } catch (e) {
          ghStatus(String(e.message) === '403' || String(e.message) === '429' ? 'GitHub says “slow down” — try ⟳ again in a minute.' : 'Couldn’t reach GitHub right now — try ⟳ again.');
        }
      };
      $('#gh-fetch')?.addEventListener('click', () => { const el = form.elements['github']; if (el?.value.trim() && !confirm('Replace what’s in the GitHub box with your commits?')) return; ghFetch(true); });

      // remind about drafts from other days that were never published
      const showDrafts = () => {
        const list = Object.keys(localStorage).filter((k) => k.startsWith('log:draft:')).map((k) => k.slice(10))
          .filter((d) => d !== dateIn.value && !CFG.existing.includes(d) && /^\d{4}-\d{2}-\d{2}$/.test(d))
          .filter((d) => { try { const o = JSON.parse(localStorage.getItem('log:draft:' + d) || '{}'); return Object.entries(o).some(([k, x]) => !k.startsWith('_') && k !== 'github' && String(x).trim()); } catch { return false; } })
          .sort().reverse().slice(0, 5);
        const el = $('#drafts'); el.hidden = !list.length;
        el.innerHTML = list.length ? 'Unpublished draft' + (list.length > 1 ? 's' : '') + ': ' + list.map((d) => `<button type="button" class="link" data-open="${d}">${new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' })} →</button>`).join(' ') : '';
        $$('[data-open]', el).forEach((b) => b.addEventListener('click', () => { dateIn.value = b.dataset.open; loadDay(); }));
      };
      const loadDay = () => {
        let v = {};
        try { v = JSON.parse(localStorage.getItem(key()) || '{}'); } catch {}
        autoMem = v._auto || {}; const savedAt = v._saved; delete v._auto; delete v._saved;
        write(v); update(false);
        showDrafts();
        $('#saved').textContent = Object.keys(v).length ? `Draft restored${savedAt ? ` · last saved ${new Date(savedAt).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' })}` : ''}` : 'Draft saves automatically · even if you close the site';
        const url = new URL(location.href);
        dateIn.value === today ? url.searchParams.delete('date') : url.searchParams.set('date', dateIn.value);
        history.replaceState(null, '', url);
        ghStatus(''); ghFetch(false);
      };

      form.addEventListener('input', () => update());
      form.addEventListener('change', () => update());
      dateIn.addEventListener('change', () => { if (dateIn.value > today) dateIn.value = today; loadDay(); });
      $('#clear').addEventListener('click', () => { if (confirm('Clear the draft for ' + dateIn.value + '?')) { localStorage.removeItem(key()); write({}); update(false); } });

      const copy = async () => { try { await navigator.clipboard.writeText(md); return true; } catch { return false; } };
      $('#copy').addEventListener('click', async () => { $('#msg').textContent = (await copy()) ? 'Copied — paste it into a new file in src/content/journal.' : 'Copy failed — use Download instead.'; });
      $('#download').addEventListener('click', () => {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([md], { type: 'text/markdown' }));
        a.download = `${dateIn.value}.md`; a.click(); URL.revokeObjectURL(a.href);
      });
      $('#publish').addEventListener('click', async () => {
        const v = read();
        if (!v.headline) { $('#msg').textContent = 'Add a headline first — it becomes the title.'; $('#f-headline').focus(); return; }
        const { owner, name, branch, dir } = CFG.repo;
        const file = `${dateIn.value}.md`;
        let url;
        if (CFG.existing.includes(dateIn.value)) {
          await copy();
          url = `https://github.com/${owner}/${name}/edit/${branch}/${dir}/${file}`;
          $('#msg').textContent = 'Entry exists — opened the editor and copied your new text. Paste it in, then Commit.';
        } else {
          url = `https://github.com/${owner}/${name}/new/${branch}/${dir}?filename=${encodeURIComponent(file)}&value=${encodeURIComponent(md)}`;
          $('#msg').innerHTML = 'Opened GitHub — press <b>Commit changes</b>. Your streak updates in ~1 minute.';
        }
        window.open(url, '_blank', 'noopener');
      });

      loadDay();
    })();
  </script>
</Base>

