---
// GOALS — daily & weekly habits.
// Storage (this browser only, never sent anywhere):
//   goals:2026-11-28  -> { "<daily id>": true }                 (one per day)
//   goals:2026-W48    -> { "<weekly id>@wed": true }             (one per ISO week, ticked by weekday)
//   goals:config      -> your edited goal list (names, times, days) — overrides the public defaults
// The Google Sheet stays the master record; Export / Import moves everything between devices.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { goals } from '../data/profile';
---
<Base title="Goals" description="Aryan Jain's daily and weekly goals — study, health and mind, tracked every day.">
  <section class="head">
    <div class="wrap">
      <p class="kicker">Goals</p>
      <h1>Small things, <em>every day.</em></h1>
      <p class="lead">The habits I track daily and weekly. Discipline is the real portfolio — this is where it lives.</p>
      <div class="cta">
        {site.trackerUrl && <a class="btn primary" href={site.trackerUrl} target="_blank" rel="noopener">Open my tracker ↗</a>}
        <a class="btn ghost" href="/log/">✎ Write today’s entry</a>
        <button type="button" class="btn ghost" id="edit-open">✎ Edit goals</button>
      </div>
    </div>
  </section>

  <!-- ============ OVERVIEW ============ -->
  <section class="overview">
    <div class="wrap">
      <div class="stats">
        <div class="stat"><b data-stat="streak">0</b><span>day streak</span></div>
        <div class="stat"><b data-stat="best">0</b><span>best streak</span></div>
        <div class="stat"><b data-stat="week">0%</b><span>this week</span></div>
        <div class="stat"><b data-stat="month">0%</b><span>this month</span></div>
      </div>
      <div class="card cal">
        <div class="calhead">
          <div><p class="label">History</p><h2>Every day, at a glance</h2></div>
          <p class="muted small">A day counts towards the streak at <b>50%+</b>. Click any square to open that day.</p>
        </div>
        <div class="calscroll"><div class="calgrid" data-cal aria-label="Daily goals history"></div></div>
        <div class="legend"><span>0%</span><i class="c l0"></i><i class="c l1"></i><i class="c l2"></i><i class="c l3"></i><i class="c l4"></i><span>100%</span></div>
      </div>
      <div class="habits card">
        <p class="label">Last 30 days</p>
        <div class="hgrid">
          <div><p class="hk">Strongest habit</p><p class="hv" data-best-habit>—</p></div>
          <div><p class="hk">Needs attention</p><p class="hv" data-weak-habit>—</p></div>
          <div><p class="hk">Days logged</p><p class="hv" data-logged>0</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DAY ============ -->
  <section class="board">
    <div class="wrap">
      <div class="panel" data-scope="day">
        <header>
          <div class="dayhead">
            <p class="label" data-day-label>Today</p>
            <div class="daynav">
              <button type="button" class="nav" data-shift="-1" aria-label="Previous day">‹</button>
              <h2 id="day-title">—</h2>
              <button type="button" class="nav" data-shift="1" aria-label="Next day">›</button>
            </div>
            <div class="daytools">
              <label class="pick"><span>Pick a date</span><input type="date" id="pick" /></label>
              <button type="button" class="link" id="to-today" hidden>Back to today</button>
            </div>
          </div>
          <div class="ring" aria-hidden="true"><svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="19" /><circle class="fg" cx="22" cy="22" r="19" /></svg><span data-pct>0%</span></div>
        </header>
        <p class="future" data-future hidden>That day hasn’t happened yet — come back then.</p>
        <div data-daily></div>
        <p class="done" data-done>—</p>
      </div>

      <!-- ============ WEEK (by weekday) ============ -->
      <div class="panel week" data-scope="week">
        <header>
          <div>
            <p class="label" data-week-label>This week</p>
            <h2 id="week-title">—</h2>
          </div>
          <div class="ring" aria-hidden="true"><svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="19" /><circle class="fg" cx="22" cy="22" r="19" /></svg><span data-pct>0%</span></div>
        </header>
        <div class="wscroll"><table class="wgrid" data-weekly></table></div>
        <p class="fine">Tick the day you actually did it. <span class="plan-dot"></span> marks a planned day. A task is done when it hits its times-per-week.</p>
        <p class="done" data-done>—</p>
      </div>

      <div class="panel backup">
        <p class="label">Backup &amp; sync</p>
        <p class="fine">Everything here — ticks and your edited goals — lives in this browser only. Export a file to back it up, or import it on your phone/laptop.</p>
        <div class="bbtns">
          <button type="button" class="btn ghost small-btn" id="export">Export history</button>
          <label class="btn ghost small-btn importlbl">Import file<input type="file" id="import" accept="application/json" hidden /></label>
        </div>
        <p class="fine" id="backup-msg" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- ============ EDITOR ============ -->
  <dialog id="editor" class="editor" aria-label="Edit goals">
    <form method="dialog" class="ehead">
      <div><p class="label">Edit goals</p><h2>Your list, your rules.</h2></div>
      <button class="x" aria-label="Close">✕</button>
    </form>
    <p class="fine privacy">🔒 Your edits are saved only in this browser — they are <b>not</b> published on the website. Private items (like medicine) are safe to add here.</p>

    <h3>Daily</h3>
    <div class="erows" data-edit-daily></div>
    <button type="button" class="add" data-add="daily">+ Add daily goal</button>

    <h3>Weekly</h3>
    <div class="erows" data-edit-weekly></div>
    <button type="button" class="add" data-add="weekly">+ Add weekly goal</button>

    <div class="efoot">
      <button type="button" class="link danger" id="edit-reset">Reset to default list</button>
      <div class="ebtns">
        <button type="button" class="btn ghost small-btn" id="edit-cancel">Cancel</button>
        <button type="button" class="btn primary small-btn" id="edit-save">Save</button>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="goal-defaults" set:html={JSON.stringify(goals)} />

  <script is:inline>
    (() => {
      const DEFAULTS = JSON.parse(document.getElementById('goal-defaults').textContent);
      const DAYS = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
      const DAYLBL = { mon: 'Mon', tue: 'Tue', wed: 'Wed', thu: 'Thu', fri: 'Fri', sat: 'Sat', sun: 'Sun' };
      const CATS = ['Study', 'Health', 'Mind', 'Other'];
      const THRESH = 0.5;
      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const pad = (n) => String(n).padStart(2, '0');
      const ymd = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      const parse = (s) => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };
      const addDays = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
      const monday = (d) => { const x = new Date(d); while (x.getDay() !== 1) x.setDate(x.getDate() - 1); return x; };
      const isoWeek = (d) => {
        const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
        t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));
        const w = Math.ceil(((t - new Date(Date.UTC(t.getUTCFullYear(), 0, 1))) / 86400000 + 1) / 7);
        return { key: `${t.getUTCFullYear()}-W${w}`, week: w };
      };
      const PREF = () => { try { return JSON.parse(localStorage.getItem('pref:settings') || '{}'); } catch { return {}; } }; // Settings (src/lib/prefs.ts)
      const fmtTime = (t) => { if (!t) return ''; const [h, m] = t.split(':').map(Number); return PREF().clock === '24' ? `${pad(h)}:${pad(m)}` : `${((h + 11) % 12) + 1}:${pad(m)} ${h < 12 ? 'AM' : 'PM'}`; };
      const load = (k) => { try { return JSON.parse(localStorage.getItem(`goals:${k}`) || '{}'); } catch { return {}; } };
      const save = (k, v) => { try { localStorage.setItem(`goals:${k}`, JSON.stringify(v)); } catch {} };

      // ---------- Config (your edited list, or the defaults) ----------
      const getConfig = () => {
        const c = load('config');
        return c && Array.isArray(c.daily) && Array.isArray(c.weekly) ? c : JSON.parse(JSON.stringify(DEFAULTS));
      };
      let CFG = getConfig();
      const sortedDaily = () => {
        const byTime = (a, b) => (a.time || '99') .localeCompare(b.time || '99');
        const cats = [...new Set([...CATS, ...CFG.daily.map((g) => g.cat || 'Other')])];
        return cats.map((c) => ({ cat: c, list: CFG.daily.filter((g) => (g.cat || 'Other') === c).sort(byTime) })).filter((g) => g.list.length);
      };
      const dayPct = (k) => { const v = load(k); const n = CFG.daily.length; return n ? CFG.daily.filter((g) => v[g.id]).length / n : 0; };

      const today = new Date(); today.setHours(0, 0, 0, 0);
      const todayKey = ymd(today);
      let sel = new Date(today);
      const qp = new URLSearchParams(location.search);
      if (/^\d{4}-\d{2}-\d{2}$/.test(qp.get('date') || '') && parse(qp.get('date')) <= today) sel = parse(qp.get('date'));

      const C = 2 * Math.PI * 19;
      const ring = (panel, done, total, unit = '') => {
        const pct = total ? done / total : 0;
        panel.querySelector('[data-pct]').textContent = Math.round(pct * 100) + '%';
        const fg = panel.querySelector('.fg');
        fg.style.strokeDasharray = String(C);
        fg.style.strokeDashoffset = String(C * (1 - pct));
        panel.querySelector('[data-done]').textContent = `${done} of ${total} ${unit}done`;
        panel.classList.toggle('complete', total > 0 && done >= total);
      };

      // ---------- DAY ----------
      const dayPanel = $('[data-scope="day"]');
      const pick = $('#pick'); pick.max = todayKey;
      const renderDaily = (k, readOnly) => {
        const v = load(k);
        $('[data-daily]', dayPanel).innerHTML = sortedDaily().map((g) => `
          <div class="cat"><p class="catname">${esc(g.cat)}</p><ul>
          ${g.list.map((x) => `<li><label class="chk">
              <input type="checkbox" data-id="${esc(x.id)}" ${v[x.id] ? 'checked' : ''} ${readOnly ? 'disabled' : ''}/>
              <span class="box" aria-hidden="true"></span><span class="txt">${esc(x.name)}</span>
              ${x.time ? `<span class="time">${fmtTime(x.time)}</span>` : ''}
            </label></li>`).join('')}
          </ul></div>`).join('');
        const boxes = $$('input[type=checkbox]', dayPanel);
        boxes.forEach((b) => b.addEventListener('change', () => {
          const cur = load(k); cur[b.dataset.id] = b.checked; save(k, cur);
          ring(dayPanel, boxes.filter((x) => x.checked).length, boxes.length);
          renderOverview();
        }));
        ring(dayPanel, boxes.filter((x) => x.checked).length, boxes.length);
      };

      // ---------- WEEK (Mon–Sun grid) ----------
      const weekPanel = $('[data-scope="week"]');
      const renderWeekly = (d, readOnly) => {
        const w = isoWeek(d);
        const mon = monday(d);
        // Settings -> Week starts: Sunday shows Sun..Sat. Ticks are still stored per ISO week (Mon-Sun) + day name.
        let start = mon;
        if (PREF().weekStart === 'sun') { start = new Date(d); while (start.getDay() !== 0) start.setDate(start.getDate() - 1); }
        const dates = DAYS.map((_, i) => addDays(start, i));
        const cell = dates.map((dt) => ({ wk: isoWeek(dt).key, dd: DAYS[(dt.getDay() + 6) % 7] }));
        const has = (id, i) => !!load(cell[i].wk)[`${id}@${cell[i].dd}`];
        $('#week-title').textContent = `${dates[0].toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })} – ${dates[6].toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}`;
        $('[data-week-label]').textContent = `Week ${w.week}${ymd(monday(today)) === ymd(mon) ? ' · this week' : ''}`;
        const head = `<thead><tr><th class="tname">Task</th>${cell.map((c, i) => `<th class="${ymd(dates[i]) === todayKey ? 'today' : ''}">${DAYLBL[c.dd]}<small>${dates[i].getDate()}</small></th>`).join('')}<th class="tcount">Done</th></tr></thead>`;
        const body = CFG.weekly.map((t) => {
          const ticks = cell.filter((_, i) => has(t.id, i)).length;
          const target = Math.max(1, Number(t.target) || 1);
          return `<tr class="${ticks >= target ? 'met' : ''}">
            <th class="tname" scope="row">${esc(t.name)}<span class="tmeta">${(t.days && t.days.length ? t.days.map((x) => DAYLBL[x]).join(' & ') : 'Any day')}${t.time ? ' · ' + fmtTime(t.time) : ''}</span></th>
            ${cell.map(({ wk, dd }, i) => {
              const fut = dates[i] > today;
              const planned = t.days && t.days.includes(dd);
              return `<td class="${planned ? 'planned' : ''}"><label class="cell-chk" title="${esc(t.name)} — ${DAYLBL[dd]}">
                <input type="checkbox" data-wk="${wk}" data-wid="${esc(t.id)}@${dd}" ${has(t.id, i) ? 'checked' : ''} ${readOnly || fut ? 'disabled' : ''}/>
                <span class="box" aria-hidden="true"></span><span class="sr">${esc(t.name)} ${DAYLBL[dd]}</span></label></td>`;
            }).join('')}
            <td class="tcount">${Math.min(ticks, target)}/${target}</td></tr>`;
        }).join('');
        $('[data-weekly]').innerHTML = head + `<tbody>${body}</tbody>`;
        const total = CFG.weekly.reduce((s, t) => s + Math.max(1, Number(t.target) || 1), 0);
        const doneCount = () => CFG.weekly.reduce((s, t) => s + Math.min(cell.filter((_, i) => has(t.id, i)).length, Math.max(1, Number(t.target) || 1)), 0);
        $$('input[data-wid]', weekPanel).forEach((b) => b.addEventListener('change', () => {
          const k = b.dataset.wk, cur = load(k); cur[b.dataset.wid] = b.checked; save(k, cur);
          renderWeekly(d, readOnly);
        }));
        ring(weekPanel, doneCount(), total, 'times ');
      };

      addEventListener('ascent:prefs', () => renderDay()); // clock / week start changed in Settings
      const renderDay = () => {
        const k = ymd(sel);
        const future = sel > today;
        const diff = Math.round((today - sel) / 86400000);
        $('#day-title').textContent = sel.toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', ...(sel.getFullYear() !== today.getFullYear() ? { year: 'numeric' } : {}) });
        $('[data-day-label]').textContent = diff === 0 ? 'Today' : diff === 1 ? 'Yesterday' : future ? 'Upcoming' : `${diff} days ago`;
        $('[data-future]').hidden = !future;
        $('#to-today').hidden = diff === 0;
        $('[data-shift="1"]').disabled = sel >= today;
        pick.value = k;
        renderDaily(k, future);
        renderWeekly(sel, future);
        $$('.cell').forEach((c) => c.classList.toggle('sel', c.dataset.day === k));
        const url = new URL(location.href);
        k === todayKey ? url.searchParams.delete('date') : url.searchParams.set('date', k);
        history.replaceState(null, '', url);
      };
      $$('[data-shift]').forEach((b) => b.addEventListener('click', () => { const n = addDays(sel, Number(b.dataset.shift)); if (n <= today) { sel = n; renderDay(); } }));
      $('#to-today').addEventListener('click', () => { sel = new Date(today); renderDay(); });
      pick.addEventListener('change', () => { if (pick.value) { const d = parse(pick.value); if (d <= today) { sel = d; renderDay(); } } });

      // ---------- OVERVIEW ----------
      const cal = $('[data-cal]');
      const WEEKS = 52; // poora ek saal
      const renderOverview = () => {
        const end = new Date(today);
        const start = monday(addDays(end, -(WEEKS * 7 - 1)));
        cal.innerHTML = '';
        let lastMonth = -1;
        for (let d = new Date(start); d <= end;) {
          const colEl = document.createElement('div'); colEl.className = 'col';
          const m = document.createElement('span'); m.className = 'mon';
          if (d.getMonth() !== lastMonth) { m.textContent = d.toLocaleDateString('en', { month: 'short' }); lastMonth = d.getMonth(); }
          colEl.appendChild(m);
          for (let r = 0; r < 7; r++, d = addDays(d, 1)) {
            const k = ymd(d);
            const cell = document.createElement('button');
            cell.type = 'button'; cell.className = 'cell c';
            if (d > end) { cell.classList.add('future'); cell.disabled = true; colEl.appendChild(cell); continue; }
            const p = dayPct(k);
            cell.classList.add(p === 0 ? 'l0' : p < 0.25 ? 'l1' : p < 0.5 ? 'l2' : p < 1 ? 'l3' : 'l4');
            cell.dataset.day = k;
            cell.title = `${d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })} — ${Math.round(p * 100)}%`;
            cell.setAttribute('aria-label', cell.title);
            if (k === ymd(sel)) cell.classList.add('sel');
            cell.addEventListener('click', () => { sel = parse(k); renderDay(); dayPanel.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
            colEl.appendChild(cell);
          }
          cal.appendChild(colEl);
        }
        const sc = cal.parentElement; sc.scrollLeft = sc.scrollWidth;

        const good = (d) => dayPct(ymd(d)) >= THRESH;
        let cur = 0; let d = new Date(today);
        if (!good(d)) d = addDays(d, -1);
        while (good(d)) { cur++; d = addDays(d, -1); }
        const keys = Object.keys(localStorage).filter((k) => /^goals:\d{4}-\d{2}-\d{2}$/.test(k)).map((k) => k.slice(6)).sort();
        let best = 0, run = 0, prev = null;
        keys.forEach((k) => {
          if (dayPct(k) >= THRESH) { const dd = parse(k); run = prev && Math.round((dd - prev) / 86400000) === 1 ? run + 1 : 1; prev = dd; best = Math.max(best, run); }
          else { run = 0; prev = null; }
        });
        $('[data-stat="streak"]').textContent = cur;
        $('[data-stat="best"]').textContent = Math.max(best, cur);
        const avg = (from) => { let s = 0, n = 0; for (let x = new Date(from); x <= today; x = addDays(x, 1)) { s += dayPct(ymd(x)); n++; } return n ? Math.round((s / n) * 100) : 0; };
        $('[data-stat="week"]').textContent = avg(monday(today)) + '%';
        $('[data-stat="month"]').textContent = avg(new Date(today.getFullYear(), today.getMonth(), 1)) + '%';

        const counts = Object.fromEntries(CFG.daily.map((g) => [g.id, 0]));
        let logged = 0;
        for (let i = 0; i < 30; i++) {
          const v = load(ymd(addDays(today, -i)));
          if (!Object.values(v).some(Boolean)) continue;
          logged++;
          CFG.daily.forEach((g) => { if (v[g.id]) counts[g.id]++; });
        }
        $('[data-logged]').textContent = logged;
        if (logged && CFG.daily.length) {
          const ranked = CFG.daily.map((g) => ({ ...g, n: counts[g.id] })).sort((a, b) => b.n - a.n);
          $('[data-best-habit]').textContent = `${ranked[0].name} · ${ranked[0].n}/${logged}`;
          const w = ranked[ranked.length - 1];
          $('[data-weak-habit]').textContent = `${w.name} · ${w.n}/${logged}`;
        } else {
          $('[data-best-habit]').textContent = 'Start ticking ✦';
          $('[data-weak-habit]').textContent = '—';
        }
      };

      // ---------- EDITOR ----------
      const dlg = $('#editor');
      let draft;
      const uid = (p) => `${p}-c${Date.now().toString(36)}${Math.random().toString(36).slice(2, 5)}`;
      const renderEditor = () => {
        $('[data-edit-daily]').innerHTML = draft.daily.map((g, i) => `
          <div class="erow" data-i="${i}" data-kind="daily">
            <input class="ename" aria-label="Goal name" value="${esc(g.name)}" placeholder="Goal name" data-f="name"/>
            <select aria-label="Category" data-f="cat">${CATS.map((c) => `<option ${((g.cat || 'Other') === c) ? 'selected' : ''}>${c}</option>`).join('')}</select>
            <input type="time" aria-label="Time (optional)" value="${esc(g.time || '')}" data-f="time"/>
            <button type="button" class="del" aria-label="Remove ${esc(g.name)}" data-del>✕</button>
          </div>`).join('');
        $('[data-edit-weekly]').innerHTML = draft.weekly.map((t, i) => `
          <div class="erow wrow" data-i="${i}" data-kind="weekly">
            <input class="ename" aria-label="Task name" value="${esc(t.name)}" placeholder="Task name" data-f="name"/>
            <div class="days" role="group" aria-label="Planned days">${DAYS.map((dd) => `<button type="button" class="dchip ${(t.days || []).includes(dd) ? 'on' : ''}" data-day="${dd}" aria-pressed="${(t.days || []).includes(dd)}">${DAYLBL[dd].slice(0, 2)}</button>`).join('')}</div>
            <label class="tgt">×<input type="number" min="1" max="7" value="${Number(t.target) || 1}" aria-label="Times per week" data-f="target"/>/wk</label>
            <input type="time" aria-label="Time (optional)" value="${esc(t.time || '')}" data-f="time"/>
            <button type="button" class="del" aria-label="Remove ${esc(t.name)}" data-del>✕</button>
          </div>`).join('');
      };
      dlg.addEventListener('input', (e) => {
        const row = e.target.closest('.erow'); if (!row || !e.target.dataset.f) return;
        const item = draft[row.dataset.kind][row.dataset.i];
        item[e.target.dataset.f] = e.target.dataset.f === 'target' ? Number(e.target.value) || 1 : e.target.value;
      });
      dlg.addEventListener('click', (e) => {
        const row = e.target.closest('.erow');
        if (e.target.matches('[data-del]') && row) { draft[row.dataset.kind].splice(row.dataset.i, 1); renderEditor(); }
        if (e.target.matches('.dchip') && row) {
          const t = draft.weekly[row.dataset.i]; t.days = t.days || [];
          const dd = e.target.dataset.day;
          t.days = t.days.includes(dd) ? t.days.filter((x) => x !== dd) : DAYS.filter((x) => x === dd || t.days.includes(x));
          if (t.days.length > (Number(t.target) || 1)) t.target = t.days.length;
          renderEditor();
        }
        if (e.target.matches('[data-add]')) {
          const kind = e.target.dataset.add;
          draft[kind].push(kind === 'daily' ? { id: uid('d'), name: '', cat: 'Study' } : { id: uid('w'), name: '', days: [], target: 1 });
          renderEditor();
          const rows = $$(`[data-kind="${kind}"] .ename`, dlg); rows[rows.length - 1]?.focus();
        }
      });
      $('#edit-open').addEventListener('click', () => { draft = JSON.parse(JSON.stringify(CFG)); renderEditor(); dlg.showModal(); });
      $('#edit-cancel').addEventListener('click', () => dlg.close());
      $('#edit-save').addEventListener('click', () => {
        draft.daily = draft.daily.filter((g) => g.name.trim()).map((g) => ({ ...g, name: g.name.trim(), time: g.time || undefined }));
        draft.weekly = draft.weekly.filter((t) => t.name.trim()).map((t) => ({ ...t, name: t.name.trim(), time: t.time || undefined }));
        save('config', draft); CFG = getConfig(); dlg.close(); renderOverview(); renderDay();
        $('#backup-msg').textContent = 'Goals updated — saved in this browser.';
      });
      $('#edit-reset').addEventListener('click', () => {
        if (!confirm('Go back to the default goal list? Your ticks stay; only the list resets.')) return;
        localStorage.removeItem('goals:config'); CFG = getConfig(); draft = JSON.parse(JSON.stringify(CFG)); renderEditor(); renderOverview(); renderDay();
      });

      // ---------- EXPORT / IMPORT ----------
      const msg = $('#backup-msg');
      $('#export').addEventListener('click', () => {
        const data = {};
        Object.keys(localStorage).filter((k) => k.startsWith('goals:')).forEach((k) => (data[k] = JSON.parse(localStorage.getItem(k))));
        const blob = new Blob([JSON.stringify({ app: 'ascent-goals', exported: new Date().toISOString(), data }, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = `ascent-goals-${todayKey}.json`; a.click(); URL.revokeObjectURL(a.href);
        msg.textContent = `Exported ${Object.keys(data).length} entries (ticks + your goal list).`;
      });
      $('#import').addEventListener('change', async (e) => {
        const f = e.target.files[0]; if (!f) return;
        try {
          const json = JSON.parse(await f.text());
          let n = 0;
          Object.entries(json.data || {}).forEach(([k, v]) => {
            if (typeof v !== 'object' || v === null) return;
            if (k === 'goals:config') { if (Array.isArray(v.daily) && Array.isArray(v.weekly)) { save('config', v); n++; } return; }
            if (!/^goals:\d{4}-(\d{2}-\d{2}|W\d{1,2})$/.test(k)) return;
            save(k.slice(6), { ...load(k.slice(6)), ...v }); n++;
          });
          CFG = getConfig();
          msg.textContent = `Imported ${n} entries — merged with what was here.`;
          renderOverview(); renderDay();
        } catch { msg.textContent = 'That file could not be read. Use a file exported from this page.'; }
        e.target.value = '';
      });

      renderOverview();
      renderDay();
    })();
  </script>
