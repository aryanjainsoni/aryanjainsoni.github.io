---
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import Stats from '../components/Stats.astro';
import TopicCard from '../components/TopicCard.astro';
import Socials from '../components/Socials.astro';
import { site, topics } from '../data/site';
import { getEntries, getStats, streaks } from '../lib/journal';
import { getLeetCode, leetLevel } from '../lib/leetcode';

const entries = await getEntries();
const journal = getStats(entries);
const latest = entries.slice(0, 3);

const lc = await getLeetCode();
const lcLevels = new Map([...(lc?.byDay ?? [])].map(([d, n]) => [d, leetLevel(n)]));
const lcLabels = new Map([...(lc?.byDay ?? [])].map(([d, n]) => [d, `${n} submission${n > 1 ? 's' : ''}`]));
const lcStreak = lc ? streaks(lc.byDay.keys()) : null;

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const now = ['🤖 AI course · Vedantu', '🧩 DSA · Apex series', '🏋️ Gym', '🏊 Swimming'];
const ticker = ['C++', 'Python', 'DSA', 'Machine Learning', 'Java', 'SQL', 'Streamlit', 'Git', 'Football', 'Art', 'Swimming', 'Gym', 'Abacus'];
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="wrap hero-grid">
     <div class="hero-text">
      <p class="issue" data-reveal>
        <span class="live"></span>
        Day <span id="day" data-start={site.startDate}>1</span> · Building in public
      </p>
      <h1 data-reveal style="--d:.08s">
        Learning out loud,<br /><em class="sun">one day at a time.</em>
      </h1>
      <p class="lead" data-reveal style="--d:.16s">
        I'm <b>{site.name}</b> — CSE student, problem solver, athlete, artist. This is my whole journey, in one place.
      </p>
      <div class="ctas" data-reveal style="--d:.24s">
        <a class="btn primary" href="/journal/">Read the journal →</a>
        <a class="btn" href="/about/">About me</a>
      </div>
      <div class="now" data-reveal style="--d:.32s">
        <span class="muted">Right now</span>
        {now.map((n) => <span class="chip">{n}</span>)}
      </div>
     </div>

     <!-- Badi gol photo + neeche saare socials. Click karne par poori photo khulti hai. -->
     <div class="hero-photo" data-reveal style="--d:.2s">
       <button class="portrait" type="button" id="open-photo" aria-label="View full photo of Aryan Jain">
         <span class="halo" aria-hidden="true"></span>
         <img src="/images/me-big.jpg" alt="Aryan Jain" width="600" height="600" />
         <span class="hint">View photo ⤢</span>
       </button>
       <Socials />
     </div>
    </div>

    <dialog id="photo-dialog" class="lightbox" aria-label="Full photo of Aryan Jain">
      <form method="dialog"><button class="close" aria-label="Close">✕</button></form>
      <img data-src="/images/me-full.jpg" alt="Aryan Jain — full photo" width="900" height="2000" />
    </dialog>
    <script is:inline>
      // Photo click -> poori photo popup mein (pehli baar click par hi load hoti hai)
      const dlg = document.getElementById('photo-dialog');
      document.getElementById('open-photo').addEventListener('click', () => {
        const img = dlg.querySelector('img');
        if (!img.src) img.src = img.dataset.src;
        dlg.showModal();
      });
      // Photo ke bahar (kaale hisse par) click -> band
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    </script>
    <script is:inline>
      const el = document.getElementById('day');
      el.textContent = Math.max(1, Math.floor((Date.now() - new Date(el.dataset.start)) / 86400000) + 1);
    </script>
  </section>

  <!-- ============ TICKER ============ -->
  <div class="ticker" aria-hidden="true">
    <div class="track">
      {[...ticker, ...ticker].map((t) => <span>{t}<i>✦</i></span>)}
    </div>
  </div>

  <!-- ============ CONSISTENCY ============ -->
  <section>
    <div class="wrap">
      <p class="kicker" data-reveal>Consistency</p>
      <h2 class="section-title" data-reveal>Showing up, <em class="sun">daily.</em></h2>
      <Stats
        items={[
          { value: journal.current, label: 'journal streak 🔥' },
          { value: journal.total, label: 'days journaled' },
          ...(lc ? [
            { value: lc.solved.all, label: 'LeetCode solved' },
            { value: lcStreak!.current, label: 'LeetCode streak ⚡' },
          ] : []),
        ]}
      />
      <div class="maps">
        <div class="card map" data-reveal>
          <div class="maphead"><h3>Journal</h3><span class="muted">one square = one day written</span></div>
          <Heatmap byDay={journal.byDay} empty="no entry" />
        </div>
        {lc && (
          <div class="card map leet" data-reveal>
            <div class="maphead">
              <h3>LeetCode</h3>
              <span class="muted">
                <b class="e">{lc.solved.easy} easy</b> · <b class="m">{lc.solved.medium} medium</b> · <b class="h">{lc.solved.hard} hard</b> · auto-updated nightly
              </span>
            </div>
            <Heatmap byDay={lcLevels} labels={lcLabels} empty="no submissions" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ============ TOPICS ============ -->
  <section>
    <div class="wrap">
      <p class="kicker" data-reveal>The journey</p>
      <h2 class="section-title" data-reveal>Everything I am, <em class="sun">in chapters.</em></h2>
      <div class="topics">
        {topics.map((t, i) => <TopicCard topic={t} delay={(i % 3) * 0.08} />)}
      </div>
    </div>
  </section>

  <!-- ============ FEATURED ============ -->
  <section>
    <div class="wrap">
      <p class="kicker" data-reveal>Featured build</p>
      <div class="feature card" data-reveal data-tilt>
        <div>
          <h2>Breast Cancer <em class="sun">Prediction</em></h2>
          <p class="muted">ML web app that flags tumours as benign or malignant. Team of 3 — I owned the repo, fixes and deployment.</p>
          <div class="ctas">
            <a class="btn primary" href="https://breastcancer-gk.streamlit.app/" target="_blank" rel="noopener">Live demo ↗</a>
            <a class="btn" href="https://github.com/aryanjainsoni/Breast_cancer_Prediction_model" target="_blank" rel="noopener">Code</a>
          </div>
        </div>
        <div class="nums">
          <div><b>96.5%</b><span>accuracy</span></div>
          <div><b>100%</b><span>precision</span></div>
          <div><b>95.1%</b><span>F1-score</span></div>
          <div><b>569</b><span>records</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LATEST ============ -->
  {latest.length > 0 && (
    <section>
      <div class="wrap">
        <p class="kicker" data-reveal>Latest entries</p>
        <div class="latest">
          {latest.map((e, i) => (
            <a class="card entry" href={`/journal/${e.id}/`} data-reveal data-tilt style={`--d:${i * 0.08}s`}>
              <time datetime={e.id}>{fmt(e.data.date)}</time>
              <span>{e.data.title}</span>
              <i>Read →</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  /* Hero */
  .hero { position: relative; padding-block: 110px 80px; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.55; pointer-events: none; }
  .b1 { width: 520px; height: 520px; background: #ff8a3d; top: -160px; right: -120px; animation: float 14s ease-in-out infinite; }
  .b2 { width: 420px; height: 420px; background: #ff2e7e; bottom: -200px; right: 220px; animation: float 18s ease-in-out infinite reverse; }
  :global(:root[data-theme='dark']) .blob { opacity: 0.35; }
  @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-60px, 40px) scale(1.12); } }

  .issue { display: inline-flex; align-items: center; gap: 10px; font: 500 13px 'JetBrains Mono', monospace; color: var(--muted); border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 70%, transparent); border-radius: 999px; padding: 7px 14px; margin: 0; backdrop-filter: blur(6px); }
  .live { width: 9px; height: 9px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 0 var(--accent-2); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  h1 { position: relative; font-size: clamp(2.8rem, 5.4vw, 4.3rem); margin: 26px 0 22px; letter-spacing: -0.02em; word-spacing: 0.06em; }
  .lead { position: relative; font-size: clamp(1.05rem, 2.2vw, 1.3rem); color: var(--muted); max-width: 600px; margin: 0 0 32px; }
  .lead b { color: var(--ink); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }

  /* Hero: text left, photo right */
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: center; }
  .hero-photo { display: flex; flex-direction: column; align-items: center; gap: 26px; }
  .portrait {
    position: relative; display: block; width: min(340px, 100%); aspect-ratio: 1; padding: 0;
    border: none; background: none; border-radius: 50%; cursor: zoom-in;
  }
  .portrait img {
    position: relative; z-index: 1; display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
    border: 6px solid var(--bg); transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
  }
  /* Ghoomti sunset ring + glow */
  .halo {
    position: absolute; inset: -10px; border-radius: 50%;
    background: conic-gradient(from 0deg, #ff8a3d, #ff2e7e, #962fbf, #ff8a3d);
    animation: spin-halo 8s linear infinite;
    filter: drop-shadow(0 20px 40px color-mix(in srgb, var(--accent-2) 45%, transparent));
  }
  @keyframes spin-halo { to { transform: rotate(360deg); } }
  .portrait:hover img { transform: scale(1.04); }
  .portrait:hover .halo { animation-duration: 2s; }
  .portrait:focus-visible { outline: 3px solid var(--accent); outline-offset: 14px; }
  .hint {
    position: absolute; z-index: 2; left: 50%; bottom: 14px; transform: translate(-50%, 8px);
    font: 600 13px 'Inter', sans-serif; color: #fff; background: rgba(0,0,0,.55); backdrop-filter: blur(6px);
    padding: 7px 14px; border-radius: 999px; opacity: 0; transition: opacity .25s, transform .25s; white-space: nowrap;
  }
  .portrait:hover .hint, .portrait:focus-visible .hint { opacity: 1; transform: translate(-50%, 0); }
  .hero-photo :global(.socials) { justify-content: center; }
  @media (max-width: 480px) {
    .hero-photo :global(.socials) { gap: 7px; flex-wrap: nowrap; }
    .hero-photo :global(.socials a) { width: 44px; height: 44px; }
  }

  /* Full photo popup */
  .lightbox {
    padding: 0; border: none; background: transparent; max-width: 92vw; max-height: 92vh; overflow: visible;
  }
  .lightbox::backdrop { background: rgba(10, 5, 8, 0.85); backdrop-filter: blur(8px); }
  .lightbox img { display: block; max-width: 92vw; max-height: 90vh; width: auto; height: auto; border-radius: 18px; box-shadow: 0 30px 80px rgba(0,0,0,.6); }
  .lightbox[open] { animation: pop .3s cubic-bezier(.2,.7,.2,1); }
  @keyframes pop { from { opacity: 0; transform: scale(.94); } }
  .close {
    position: absolute; top: -14px; right: -14px; z-index: 1; width: 40px; height: 40px; border-radius: 50%;
    border: none; background: var(--sun); color: #fff; font-size: 16px; cursor: pointer; box-shadow: 0 8px 20px rgba(0,0,0,.4);
  }
  @media (prefers-reduced-motion: reduce) { .halo, .lightbox[open] { animation: none; } }
  .now { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 40px; font-size: 14px; }
  .chip { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 6px 12px; font-weight: 500; }

  /* Ticker */
  .ticker { border-block: 1px solid var(--line); overflow: hidden; padding-block: 16px; background: var(--surface); }
  .track { display: flex; width: max-content; animation: slide 40s linear infinite; }
  .track span { font: italic 600 1.5rem 'Fraunces', serif; padding-inline: 18px; white-space: nowrap; display: flex; align-items: center; gap: 36px; }
  .track i { font-style: normal; font-size: 1rem; color: var(--accent); }
  .ticker:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track, .blob, .live { animation: none; } }

  /* Consistency */
  .maps { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 14px; }
  .map { --heat: var(--accent-2); min-width: 0; }
  .leet { --heat: #ffa116; }
  .maphead { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 6px 14px; margin-bottom: 14px; }
  .maphead h3 { margin: 0; font-size: 1.3rem; }
  .maphead .muted { font-size: 13px; }
  .e { color: #00b8a3; } .m { color: #ffa116; } .h { color: #ff375f; }

  /* Topics bento */
  .topics { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-flow: dense; gap: 18px; margin-top: 34px; }

  /* Featured */
  .feature { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: center; padding: 36px; }
  .feature h2 { font-size: clamp(2rem, 4.5vw, 3rem); margin: 0 0 14px; }
  .feature p { margin: 0 0 24px; font-size: 1.05rem; }
  .nums { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .nums div { background: var(--accent-soft); border-radius: 16px; padding: 18px; }
  .nums b { display: block; font: 700 2rem/1 'Fraunces', serif; background: var(--sun); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 6px; }
  .nums span { font-size: 0.85rem; color: var(--muted); }

  /* Latest */
  .latest { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .entry { display: flex; flex-direction: column; gap: 8px; color: var(--ink); font: 600 1.15rem/1.3 'Fraunces', serif; }
  .entry:hover { text-decoration: none; border-color: var(--accent); }
  .entry time { font: 500 12px 'JetBrains Mono', monospace; color: var(--accent); }
  .entry i { font: 500 13px 'Inter', sans-serif; color: var(--muted); margin-top: auto; }

  @media (max-width: 900px) { .topics { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-photo { order: -1; }
    .portrait { width: min(260px, 70vw); }
  }
  @media (max-width: 720px) {
    .hero { padding-block: 56px 56px; }
    .topics { grid-template-columns: 1fr; }
    .feature { grid-template-columns: 1fr; padding: 24px; }
    .b1 { width: 320px; height: 320px; }
    .b2 { width: 260px; height: 260px; right: -40px; }
  }
</style>
