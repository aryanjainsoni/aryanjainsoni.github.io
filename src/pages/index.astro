---
// Home page — "cinematic" version.
// Structure based on the "3D Jack Portfolio" design (MotionSites), made Aryan's own.
// Animated pieces from React Bits: Aurora (hero background), SplitText (giant name),
// Magnet (portrait follows the cursor), ScrollReveal (story text lights up while scrolling).
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import Stats from '../components/Stats.astro';
import TopicCard from '../components/TopicCard.astro';
import Socials from '../components/Socials.astro';
import Aurora from '../components/bits/Aurora';
import SplitText from '../components/bits/SplitText';
import Magnet from '../components/bits/Magnet';
import ScrollReveal from '../components/bits/ScrollReveal';
import { site, topics } from '../data/site';
import { getEntries, getStats, streaks } from '../lib/journal';
import { getLeetCode, leetLevel } from '../lib/leetcode';

const entries = await getEntries();
const journal = getStats(entries);
const latest = entries.slice(0, 3);

const lc = await getLeetCode();
const lcLevels = new Map([...(lc?.byDay ?? [])].map(([d, n]) => [d, leetLevel(n)]));
const lcLabels = new Map([...(lc?.byDay ?? [])].map(([d, n]) => [d, `${n} submission${n > 1 ? 's' : ''}`]));
const lcStreak = lc ? streaks(lc.byDay.keys()) : null;

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });

// Scroll ke saath ulti dishaon mein chalne wali do lines
const rowA = ['C++', 'Python', 'DSA', 'Machine Learning', 'Java', 'SQL', 'Streamlit', 'Git'];
const rowB = ['Abacus', 'Football', 'Sketching', 'Swimming', 'Gym', 'Vedantu AI', 'LeetCode', 'Journal'];

// "Chapters" — zindagi ke hisse, ek-ek line mein
const chapters = [
  { n: '01', title: 'Abacus', line: 'Class 4–5. Where numbers first clicked — and a certificate to prove it.' },
  { n: '02', title: 'Sport', line: 'First on sports day, again and again. A drawer full of certificates.' },
  { n: '03', title: 'Football', line: 'Class 7–9. Tournament winners — our photo made the newspaper.' },
  { n: '04', title: 'Art', line: 'Drawing since I can remember. Published in print.' },
  { n: '05', title: 'Code', line: 'B.Tech CSE at ADYPU. C++, Python, Java — and DSA, daily.' },
  { n: '06', title: 'AI', line: 'Vedantu AI course, ML projects, a model that hits 96.5%.' },
  { n: '07', title: 'Body', line: 'Gym since last year. Swimming, just learned. Discipline travels.' },
];

const projects = [
  {
    n: '01', kind: 'ML · Team of 3', name: 'Breast Cancer Prediction',
    line: 'Classifies tumours as benign or malignant. I owned the repo, the fixes and the deployment.',
    stats: [['96.5%', 'accuracy'], ['100%', 'precision'], ['95.1%', 'F1-score'], ['569', 'records']],
    links: [['Live demo', 'https://breastcancer-gk.streamlit.app/'], ['Code', 'https://github.com/aryanjainsoni/Breast_cancer_Prediction_model']],
    art: ['#ff8a3d', '#ff2e7e'],
  },
  {
    n: '02', kind: 'Product design · SRS', name: 'MentorLoop',
    line: 'An AI-enabled smart campus: QR attendance, timetables, notes, real-time chat and push alerts.',
    stats: [['QR', 'attendance'], ['Live', 'chat'], ['SRS', 'DFD · ER · Use-case'], ['2025', 'year']],
    links: [],
    art: ['#962fbf', '#ff4d8d'],
  },
  {
    n: '03', kind: 'System concept · SRS', name: 'Thermal Security System',
    line: 'Thermal imaging + neural networks to catch suspicious activity and hazards, with instant alerts.',
    stats: [['ANN', 'detection'], ['SMS', 'email alerts'], ['SRS', 'architecture'], ['2025', 'year']],
    links: [],
    art: ['#f9844a', '#7a2fbf'],
  },
];
---
<Base>
  <!-- ================= 1. CINEMATIC HERO ================= -->
  <section class="cine" aria-label="Introduction">
    <div class="aurora" aria-hidden="true">
      <Aurora
        client:load
        colorStops={['#ff8a3d', '#ff2e7e', '#7a2fbf']}
        amplitude={1.1}
        blend={0.6}
        speed={0.55}
        height={0.6}
        glow={0.8}
        layers={2}
      />
    </div>
    <div class="grain" aria-hidden="true"></div>

    <div class="cine-top wrap">
      <p class="issue"><span class="live"></span>Day <span id="day" data-start={site.startDate}>1</span> · building in public</p>
      <p class="where">Pune, India · B.Tech CSE ’28</p>
    </div>

    <h1 class="name" aria-label={site.name}>
      <span class="sr-only">{site.name}</span>
      <span aria-hidden="true" class="name-row">
        <SplitText client:load text="Aryan" tag="span" splitType="chars" effect="rise" mask delay={60} duration={1.1} trigger="load" hoverEffect="wave" textAlign="left" className="name-a" />
        <SplitText client:load text="Jain" tag="span" splitType="chars" effect="rise" mask delay={60} duration={1.1} trigger="load" hoverEffect="wave" textAlign="left" className="name-b" />
      </span>
    </h1>

    <div class="portrait-wrap">
      <Magnet client:load padding={160} magnetStrength={3} tilt={6} scale={1.03}>
        <button class="portrait" type="button" data-open-photo aria-label="View full photo of Aryan Jain">
          <span class="halo" aria-hidden="true"></span>
          <img src="/images/me-big.jpg" alt="Aryan Jain" width="600" height="600" />
          <span class="hint">View photo ⤢</span>
        </button>
      </Magnet>
    </div>

    <div class="cine-bottom wrap">
      <div class="motto">
        <p>Learning out loud —<br /><em class="sun">one day at a time.</em></p>
        <Socials />
      </div>
      <div class="cta">
        <a class="btn primary" href="/journal/">Read the journal →</a>
        <a class="btn ghost" href="/about/">About me</a>
      </div>
    </div>

    <dialog id="photo-dialog" class="lightbox" aria-label="Full photo of Aryan Jain">
      <form method="dialog"><button class="close" aria-label="Close">✕</button></form>
      <img data-src="/images/me-full.jpg" alt="Aryan Jain — full photo" width="900" height="2000" />
    </dialog>
    <script is:inline>
      // Day counter
      const dayEl = document.getElementById('day');
      dayEl.textContent = Math.max(1, Math.floor((Date.now() - new Date(dayEl.dataset.start)) / 86400000) + 1);
      // Photo click -> full photo popup (event delegation: works before & after React hydration)
      const dlg = document.getElementById('photo-dialog');
      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-open-photo]')) return;
        const img = dlg.querySelector('img');
        if (!img.src) img.src = img.dataset.src;
        dlg.showModal();
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    </script>
  </section>

  <!-- ================= 2. SCROLL-LINKED MARQUEE ================= -->
  <div class="rails" aria-hidden="true" data-rails>
    <div class="rail" data-dir="1">{[...rowA, ...rowA, ...rowA].map((t) => <span>{t}<i>✦</i></span>)}</div>
    <div class="rail alt" data-dir="-1">{[...rowB, ...rowB, ...rowB].map((t) => <span>{t}<i>✦</i></span>)}</div>
  </div>

  <!-- ================= 3. THE STORY (scroll reveal) ================= -->
  <section class="story">
    <div class="wrap">
      <p class="kicker">The story so far</p>
      <ScrollReveal
        client:visible
        baseOpacity={0.12}
        enableBlur
        blurStrength={6}
        baseRotation={2}
        splitBy="words"
        textClassName="story-text"
      >
        From an abacus in class four to algorithms in a CSE lab — with football trophies, drawings in the newspaper, a gym habit and a swimming pool in between. This site is the record. Every day, written down.
      </ScrollReveal>
    </div>
  </section>

  <!-- ================= 4. CHAPTERS (light editorial panel) ================= -->
  <section class="chapters">
    <div class="wrap">
      <h2 class="giant">Chapters</h2>
      <ol>
        {chapters.map((c, i) => (
          <li data-reveal style={`--d:${(i % 4) * 0.06}s`}>
            <span class="num">{c.n}</span>
            <div><h3>{c.title}</h3><p>{c.line}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= 5. CONSISTENCY ================= -->
  <section class="proof">
    <div class="wrap">
      <p class="kicker" data-reveal>Consistency</p>
      <h2 class="section-title" data-reveal>Showing up, <em class="sun">daily.</em></h2>
      <Stats
        items={[
          { value: journal.current, label: 'journal streak' },
          { value: journal.total, label: 'days journaled' },
          ...(lc ? [
            { value: lc.solved.all, label: 'LeetCode solved' },
            { value: lcStreak!.current, label: 'LeetCode streak' },
          ] : []),
        ]}
      />
      <div class="maps">
        <div class="card map" data-reveal>
          <div class="maphead"><h3>Journal</h3><span class="muted">one square = one day written</span></div>
          <Heatmap byDay={journal.byDay} empty="no entry" />
        </div>
        {lc && (
          <div class="card map leet" data-reveal>
            <div class="maphead">
              <h3>LeetCode</h3>
              <span class="muted">
                <b class="e">{lc.solved.easy} easy</b> · <b class="m">{lc.solved.medium} medium</b> · <b class="h">{lc.solved.hard} hard</b> · auto-updated nightly
              </span>
            </div>
            <Heatmap byDay={lcLevels} labels={lcLabels} empty="no submissions" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ================= 6. PROJECTS (sticky stacking cards) ================= -->
  <section class="work">
    <div class="wrap">
      <h2 class="giant">Work</h2>
      <div class="stack" data-stack>
        {projects.map((p, i) => (
          <article class="pcard" style={`--i:${i};--a:${p.art[0]};--b:${p.art[1]}`}>
            <div class="pinfo">
              <span class="num">{p.n}</span>
              <p class="kind">{p.kind}</p>
              <h3>{p.name}</h3>
              <p class="pline">{p.line}</p>
              {p.links.length > 0 && (
                <div class="plinks">
                  {p.links.map(([label, href], j) => (
                    <a class:list={['btn', j === 0 ? 'primary' : 'ghost']} href={href} target="_blank" rel="noopener">{label} ↗</a>
                  ))}
                </div>
              )}
            </div>
            <div class="pvisual">
              <div class="pstats">
                {p.stats.map(([v, l]) => <div><b>{v}</b><span>{l}</span></div>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 7. CHAPTER CARDS (topics) ================= -->
  <section>
    <div class="wrap">
      <p class="kicker" data-reveal>Explore</p>
      <h2 class="section-title" data-reveal>Everything I am, <em class="sun">in chapters.</em></h2>
      <div class="topics">
        {topics.map((t, i) => <TopicCard topic={t} delay={(i % 3) * 0.08} />)}
      </div>
    </div>
  </section>

  <!-- ================= 8. LATEST ================= -->
  {latest.length > 0 && (
    <section>
      <div class="wrap">
        <p class="kicker" data-reveal>Latest entries</p>
        <div class="latest">
          {latest.map((e, i) => (
            <a class="card entry" href={`/journal/${e.id}/`} data-reveal data-tilt style={`--d:${i * 0.08}s`}>
              <time datetime={e.id}>{fmt(e.data.date)}</time>
              <span>{e.data.title}</span>
              <i>Read →</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    (() => {
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (calm) return;
      // Marquee rows move in opposite directions as you scroll
      const rails = document.querySelector('[data-rails]');
      const rows = [...document.querySelectorAll('[data-rails] .rail')];
      // Project cards scale down slightly as the next one stacks over them
      const cards = [...document.querySelectorAll('[data-stack] .pcard')];
      let ticking = false;
      const update = () => {
        ticking = false;
        if (rails) {
          const r = rails.getBoundingClientRect();
          const off = (innerHeight - r.top) * 0.35;
          rows.forEach((row) => (row.style.transform = `translate3d(${(row.dataset.dir === '1' ? off - 400 : -(off - 400) - 800)}px,0,0)`));
        }
        cards.forEach((card, i) => {
          const next = cards[i + 1];
          if (!next) return;
          const gap = next.getBoundingClientRect().top - card.getBoundingClientRect().top;
          const p = Math.min(1, Math.max(0, 1 - gap / card.offsetHeight));
          card.style.setProperty('--shrink', (1 - p * 0.06).toFixed(4));
          card.style.setProperty('--dim', (p * 0.45).toFixed(3));
        });
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('resize', update);
      update();
    })();
  </script>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ================= 1. HERO — always dark & cinematic ================= */
  .cine {
    --ink: #fdf0e8; --muted: #c9aea4; --line: rgba(255,255,255,.12); --surface: rgba(255,255,255,.06);
    position: relative; isolation: isolate; overflow: hidden;
    min-height: calc(100svh - 76px); padding: 0; display: flex; flex-direction: column;
    background: radial-gradient(120% 80% at 50% 110%, #2a0f1c 0%, #0f080b 60%); color: var(--ink);
  }
  .aurora { position: absolute; inset: 0 0 35% 0; z-index: -1; opacity: .9; }
  .grain {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: .18; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .cine > .wrap { width: 100%; }
  .cine-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 28px; }
  .issue { display: inline-flex; align-items: center; gap: 10px; margin: 0; font: 500 12px 'JetBrains Mono', monospace; letter-spacing: .08em; text-transform: uppercase; border: 1px solid var(--line); background: rgba(255,255,255,.05); backdrop-filter: blur(10px); border-radius: 999px; padding: 8px 14px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: #ff4d8d; box-shadow: 0 0 0 0 #ff4d8d; animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .where { margin: 0; font: 500 12px 'JetBrains Mono', monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

  .name { margin: 3vh 0 0; padding-inline: 2.5vw; line-height: .8; letter-spacing: -.04em; font-weight: 900; }
  .name-row { display: flex; justify-content: space-between; gap: 2vw; white-space: nowrap; }
  .name :global(.name-a), .name :global(.name-b) { font: 900 clamp(4.5rem, 19vw, 19rem)/.85 'Fraunces', serif; letter-spacing: -.045em; }
  .name :global(.name-a) { color: #fdf0e8; }
  .name :global(.name-b) { color: #ff5a5f; font-style: italic; }
  /* italic letters ke swash mask mein na katein */
  .name :global(.name-b .split-char-mask) { padding: 0 .14em .06em; margin: 0 -.14em -.06em; }
  .name :global(.name-a .split-char-mask) { padding: 0 .03em .04em; margin: 0 -.03em -.04em; }

  .portrait-wrap { position: absolute; left: 50%; top: 52%; transform: translate(-50%, -50%); z-index: 2; }
  .portrait { position: relative; display: block; width: clamp(220px, 26vw, 380px); aspect-ratio: 1; padding: 0; border: none; background: none; border-radius: 50%; cursor: zoom-in; }
  .portrait img { position: relative; z-index: 1; display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 6px solid #0f080b; }
  .halo { position: absolute; inset: -9px; border-radius: 50%; background: conic-gradient(from 0deg, #ff8a3d, #ff2e7e, #962fbf, #ff8a3d); animation: spin 8s linear infinite; filter: drop-shadow(0 30px 60px rgba(255,46,126,.45)); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .portrait:hover .halo { animation-duration: 2s; }
  .portrait:focus-visible { outline: 3px solid #ff8a3d; outline-offset: 14px; }
  .hint { position: absolute; z-index: 2; left: 50%; bottom: 14px; transform: translate(-50%, 8px); font: 600 13px 'Inter', sans-serif; color: #fff; background: rgba(0,0,0,.55); backdrop-filter: blur(6px); padding: 7px 14px; border-radius: 999px; opacity: 0; transition: opacity .25s, transform .25s; white-space: nowrap; }
  .portrait:hover .hint, .portrait:focus-visible .hint { opacity: 1; transform: translate(-50%, 0); }

  .cine-bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding-bottom: 36px; }
  .motto p { margin: 0 0 18px; font: 600 clamp(1.1rem, 1.8vw, 1.6rem)/1.25 'Fraunces', serif; }
  .motto :global(.socials a) { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.14); }
  .motto :global(.socials) { --mono: #fff; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn.ghost { background: rgba(255,255,255,.06); color: #fdf0e8; border-color: rgba(255,255,255,.18); backdrop-filter: blur(10px); }

  .lightbox { padding: 0; border: none; background: transparent; max-width: 92vw; max-height: 92vh; overflow: visible; }
  .lightbox::backdrop { background: rgba(10,5,8,.88); backdrop-filter: blur(8px); }
  .lightbox img { display: block; max-width: 92vw; max-height: 90vh; width: auto; height: auto; border-radius: 18px; box-shadow: 0 30px 80px rgba(0,0,0,.6); }
  .lightbox[open] { animation: pop .3s cubic-bezier(.2,.7,.2,1); }
  @keyframes pop { from { opacity: 0; transform: scale(.94); } }
  .close { position: absolute; top: -14px; right: -14px; z-index: 1; width: 40px; height: 40px; border-radius: 50%; border: none; background: var(--sun); color: #fff; font-size: 16px; cursor: pointer; box-shadow: 0 8px 20px rgba(0,0,0,.4); }

  /* ================= 2. RAILS ================= */
  .rails { overflow: hidden; padding-block: 34px; display: grid; gap: 10px; border-block: 1px solid var(--line); background: var(--surface); }
  .rail { display: flex; width: max-content; will-change: transform; }
  .rail span { display: flex; align-items: center; gap: 28px; padding-inline: 14px; font: italic 700 clamp(1.8rem, 4vw, 3.4rem)/1.1 'Fraunces', serif; white-space: nowrap; }
  .rail.alt span { font-style: normal; color: transparent; -webkit-text-stroke: 1.2px var(--muted); }
  .rail i { font-style: normal; font-size: .5em; color: var(--accent); -webkit-text-stroke: 0; }

  /* ================= 3. STORY ================= */
  .story { padding-block: 120px; }
  .story :global(.story-text) { font: 600 clamp(1.7rem, 4.2vw, 3.4rem)/1.25 'Fraunces', serif; letter-spacing: -.02em; max-width: 1000px; }

  /* ================= 4. CHAPTERS — light panel ================= */
  .chapters { background: #fff6ef; color: #23140f; border-radius: 56px 56px 0 0; padding-block: 96px 140px; }
  .giant { font: 900 clamp(3.4rem, 13vw, 11rem)/.85 'Fraunces', serif; letter-spacing: -.05em; text-align: center; margin: 0 0 64px; background: var(--sun); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .chapters ol { list-style: none; margin: 0 auto; padding: 0; max-width: 980px; }
  .chapters li { display: grid; grid-template-columns: clamp(90px, 14vw, 170px) 1fr; align-items: center; gap: 24px; padding-block: 26px; border-top: 1px solid rgba(35,20,15,.14); }
  .chapters li:last-child { border-bottom: 1px solid rgba(35,20,15,.14); }
  .chapters .num { font: 900 clamp(2.8rem, 8vw, 6rem)/1 'Fraunces', serif; color: #23140f; letter-spacing: -.04em; transition: color .3s; }
  .chapters li:hover .num { color: #ff4d5e; }
  .chapters h3 { margin: 0 0 4px; font: 600 clamp(1.2rem, 2.2vw, 1.9rem)/1.1 'Inter', sans-serif; text-transform: uppercase; letter-spacing: .04em; }
  .chapters p { margin: 0; color: #7d6158; font-size: clamp(.95rem, 1.5vw, 1.15rem); }

  /* ================= 5. PROOF — dark panel pulled over the light one ================= */
  .proof { position: relative; z-index: 1; margin-top: -56px; border-radius: 56px 56px 0 0; background: var(--bg); }
  .maps { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 14px; }
  .map { --heat: var(--accent-2); min-width: 0; }
  .leet { --heat: #ffa116; }
  .maphead { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 6px 14px; margin-bottom: 14px; }
  .maphead h3 { margin: 0; font-size: 1.3rem; }
  .maphead .muted { font-size: 13px; }
  .e { color: #00b8a3; } .m { color: #ffa116; } .h { color: #ff375f; }

  /* ================= 6. WORK — sticky stacking cards ================= */
  .stack { display: grid; gap: 40px; padding-bottom: 6vh; }
  .pcard {
    position: sticky; top: calc(96px + var(--i) * 26px);
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 28px; align-items: stretch;
    min-height: 420px; padding: clamp(20px, 3vw, 36px); border-radius: clamp(28px, 4vw, 48px);
    background: var(--surface); border: 1.5px solid var(--line); box-shadow: var(--shadow);
    transform: scale(var(--shrink, 1)); transform-origin: center top;
  }
  .pcard::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: #000; opacity: var(--dim, 0); pointer-events: none; }
  .pinfo { display: flex; flex-direction: column; }
  .pinfo .num { font: 900 clamp(3rem, 7vw, 5.5rem)/1 'Fraunces', serif; background: linear-gradient(135deg, var(--a), var(--b)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .kind { margin: 8px 0 4px; font: 500 12px 'JetBrains Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .pinfo h3 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.6vw, 2.8rem); }
  .pline { margin: 0 0 22px; color: var(--muted); font-size: 1.05rem; max-width: 460px; }
  .plinks { display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto; }
  .pvisual { position: relative; border-radius: clamp(22px, 3vw, 36px); overflow: hidden; background: linear-gradient(140deg, var(--a), var(--b)); padding: 18px; display: flex; align-items: flex-end; }
  .pvisual::before { content: ''; position: absolute; width: 340px; height: 340px; right: -110px; top: -120px; border-radius: 50%; border: 2px solid rgba(255,255,255,.3); }
