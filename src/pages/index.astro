---
import Base from '../layouts/Base.astro';
import { site, sections, links } from '../data/site';

// Ye journey shuru hone ki date hai — isse "Day X" count hota hai.
const startDate = new Date('2026-11-27');
const day = Math.floor((Date.now() - startDate.getTime()) / 86_400_000) + 1;

// "Abhi kya chal raha hai" — jab kuch badle, yahan update karo.
const now = [
  { icon: '🤖', text: 'AI course on Vedantu — writing daily notes' },
  { icon: '🧩', text: 'DSA with the Apex DSA Series' },
  { icon: '🏋️', text: 'Gym — consistent since last year' },
  { icon: '🏊', text: 'Swimming — recently learned' },
];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="pill"><span class="dot"></span>Day <span id="day" data-start={startDate.toISOString()}>{day}</span> of building in public</p>
      <script is:inline>
        const el = document.getElementById('day');
        el.textContent = Math.floor((Date.now() - new Date(el.dataset.start)) / 86400000) + 1;
      </script>
      <h1>Hi, I'm {site.name}.<br /><span class="accent">This is my journey.</span></h1>
      <p class="lead">
        A living record of everything I learn, build and achieve — from abacus and football
        to AI and DSA. Updated every day, so you can see the work, not just the results.
      </p>
      <div class="ctas">
        <a class="btn primary" href="/about/">About me</a>
        {links.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="kicker">Right now</p>
      <h2>What I'm working on</h2>
      <div class="now">
        {now.map((n) => <div class="card now-item"><span class="icon">{n.icon}</span>{n.text}</div>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="kicker">Explore</p>
      <h2>The journey, in sections</h2>
      <p class="muted">New sections open as I build them — follow along.</p>
      <div class="grid">
        {sections.map((s) =>
          s.ready ? (
            <a class="card tile" href={s.href}>
              <span class="icon">{s.icon}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.desc}</p>
            </a>
          ) : (
            <div class="card tile soon">
              <span class="icon">{s.icon}</span>
              <h3>{s.title} <span class="tag">soon</span></h3>
              <p class="muted">{s.desc}</p>
            </div>
          )
        )}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="kicker">Featured project</p>
      <div class="card feature">
        <div>
          <h2>🩺 Breast Cancer Prediction</h2>
          <p class="muted">
            Team project (3 members): an ML web app that classifies breast tumours as benign or
            malignant. I set up and maintained the repo, fixed dependency issues and deployed the
            Streamlit dashboard.
          </p>
          <div class="ctas">
            <a class="btn primary" href="https://breastcancer-gk.streamlit.app/" target="_blank" rel="noopener">Live demo</a>
            <a class="btn" href="https://github.com/aryanjainsoni/Breast_cancer_Prediction_model" target="_blank" rel="noopener">Code</a>
          </div>
        </div>
        <div class="stats">
          <div><b>96.5%</b><span>accuracy</span></div>
          <div><b>100%</b><span>precision</span></div>
          <div><b>95.1%</b><span>F1-score</span></div>
          <div><b>569</b><span>patient records</span></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 88px 64px; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--green); margin-right: 8px; vertical-align: middle; }
  h1 { font-size: clamp(2.4rem, 6.5vw, 4.2rem); margin: 22px 0 18px; }
  h1 .accent { color: var(--accent); }
  .lead { font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--muted); max-width: 640px; margin: 0 0 30px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  h2 { font-size: 1.9rem; margin: 0 0 8px; }

  .now { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 22px; }
  .now-item { display: flex; align-items: center; gap: 12px; font-weight: 500; padding: 16px 18px; }
  .icon { font-size: 22px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 14px; margin-top: 22px; }
  .tile { display: block; color: var(--ink); transition: transform 0.15s, border-color 0.15s; }
  a.tile:hover { text-decoration: none; transform: translateY(-2px); border-color: var(--accent); }
  .tile h3 { font-size: 1.15rem; margin: 10px 0 6px; }
  .tile p { margin: 0; font-size: 0.95rem; }
  .soon { opacity: 0.75; }
  .tag { font: 500 11px 'JetBrains Mono', monospace; text-transform: uppercase; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 2px 6px; vertical-align: middle; }

  .feature { display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; align-items: center; padding: 28px; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .stats div { background: var(--accent-soft); border-radius: 12px; padding: 16px; }
  .stats b { display: block; font: 700 1.6rem 'Space Grotesk', sans-serif; color: var(--accent); }
  .stats span { font-size: 0.9rem; color: var(--muted); }

  @media (max-width: 720px) {
    .feature { grid-template-columns: 1fr; padding: 20px; }
    .hero { padding-block: 56px 40px; }
  }
</style>
