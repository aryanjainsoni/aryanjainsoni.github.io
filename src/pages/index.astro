---
// Home page — "cinematic" version.
// Structure based on the "3D Jack Portfolio" design (MotionSites), made Aryan's own.
// Animated pieces from React Bits: Aurora (hero background), SplitText (giant name),
// ScrollReveal (story text lights up while scrolling).
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import Stats from '../components/Stats.astro';
import TopicCard from '../components/TopicCard.astro';
import Socials from '../components/Socials.astro';
import Consistency from '../components/Consistency.astro';
import Aurora from '../components/bits/Aurora';
import SplitText from '../components/bits/SplitText';
import ScrollReveal from '../components/bits/ScrollReveal';
import { site, topics } from '../data/site';
import { chapters, projects, formatWhen, sortKey } from '../data/profile';
import { getEntries, getStats, streaks } from '../lib/journal';
import { getLeetCode, leetLevel } from '../lib/leetcode';

const entries = await getEntries();
const journal = getStats(entries);
const latest = entries.slice(0, 3);

const lc = await getLeetCode();
const lcLevels = new Map([...(lc?.byDay ?? [])].map(([d, n]) => [d, leetLevel(n)]));
const lcLabels = new Map([...(lc?.byDay ?? [])].map(([d, n]) => [d, `${n} submission${n > 1 ? 's' : ''}`]));
const lcStreak = lc ? streaks(lc.byDay.keys()) : null;

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });


---
<Base>
  <!-- ================= 1. HERO — quiet, editorial ================= -->
  <section class="cine" aria-label="Introduction">
    <div class="aurora" aria-hidden="true">
      <Aurora
        client:load
        colorStops={['#c2552f', '#b3365c', '#4b2a6b']}
        amplitude={0.8}
        blend={0.7}
        speed={0.25}
        height={0.5}
        glow={0.45}
        brightness={0.7}
        layers={1}
        mouseInteraction={false}
        opacity={0.55}
      />
    </div>
    <div class="grain" aria-hidden="true"></div>

    <div class="wrap hero">
      <div class="intro">
        <p class="issue"><span class="live"></span>Day <span id="day" data-start={site.startDate}>1</span> · Building in public</p>
        <h1 class="name" aria-label={site.name}>
          <span class="sr-only">{site.name}</span>
          <span aria-hidden="true" class="name-row">
            <SplitText client:load text="Aryan" tag="span" splitType="chars" effect="rise" mask delay={45} duration={1.2} trigger="load" textAlign="left" className="name-a" />
            <SplitText client:load text="Jain" tag="span" splitType="chars" effect="rise" mask delay={45} duration={1.2} trigger="load" textAlign="left" className="name-b" />
          </span>
        </h1>
        <p class="tagline">Learning out loud — <em>one day at a time.</em></p>
        <p class="lead">CSE student at ADYPU, problem solver, athlete and artist. A living record of what I learn, build and achieve.</p>
        <div class="cta">
          <a class="btn primary" href="/journal/">Read the journal</a>
          <a class="btn ghost" href="/explore/">Browse the index</a>
        </div>
        <dl class="facts">
          {lc && <div><dt>{lc.solved.all}</dt><dd>LeetCode solved</dd></div>}
          <div><dt>{journal.total}</dt><dd>days journaled</dd></div>
          <div><dt>{projects.length}</dt><dd>projects</dd></div>
        </dl>
      </div>

      <figure class="profile">
        <button class="portrait" type="button" data-open-photo aria-label="View full photo of Aryan Jain">
          <span class="halo" aria-hidden="true"></span>
          <img src="/images/me-big.jpg" alt="Aryan Jain" width="600" height="600" />
          <span class="hint">View photo</span>
        </button>
        <figcaption><Socials /></figcaption>
      </figure>
    </div>

    <dialog id="photo-dialog" class="lightbox" aria-label="Full photo of Aryan Jain">
      <form method="dialog"><button class="close" aria-label="Close">✕</button></form>
      <img data-src="/images/me-full.jpg" alt="Aryan Jain — full photo" width="900" height="2000" />
    </dialog>
    <script is:inline>
      const dayEl = document.getElementById('day');
      dayEl.textContent = Math.max(1, Math.floor((Date.now() - new Date(dayEl.dataset.start)) / 86400000) + 1);
      const dlg = document.getElementById('photo-dialog');
      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-open-photo]')) return;
        const img = dlg.querySelector('img');
        if (!img.src) img.src = img.dataset.src;
        dlg.showModal();
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    </script>
  </section>

  <!-- ================= 3. THE STORY (scroll reveal) ================= -->
  <section class="story">
    <div class="wrap">
      <p class="kicker">The story so far</p>
      <ScrollReveal
        client:visible
        baseOpacity={0.18}
        enableBlur={false}
        baseRotation={0}
        splitBy="words"
        textClassName="story-text"
      >
        From an abacus in class four to algorithms in a CSE lab — with football trophies, drawings in the newspaper, a gym habit and a swimming pool in between. This site is the record. Every day, written down.
      </ScrollReveal>
    </div>
  </section>

  <!-- ================= 4. CHAPTERS (light editorial panel) ================= -->
  <section class="chapters" id="chapters">
    <div class="wrap">
      <h2 class="giant">Chapters</h2>
      <div class="ch-sort" role="group" aria-label="Sort chapters">
        <button type="button" class="on" data-ch-sort="asc">Oldest first</button>
        <button type="button" data-ch-sort="desc">Newest first</button>
      </div>
      <ol data-chapters>
        {chapters.map((c, i) => (
          <li data-reveal data-key={sortKey(c)} style={`--d:${(i % 4) * 0.06}s`}>
            <span class="num">{c.n}</span>
            <div>
              <h3>{c.title}{formatWhen(c) ? <time>{formatWhen(c)}</time> : <span class="nodate">date soon</span>}</h3>
              <p>{c.line}</p>
            </div>
          </li>
        ))}
      </ol>
      <script is:inline>
        (() => {
          const ol = document.querySelector('[data-chapters]');
          const btns = [...document.querySelectorAll('[data-ch-sort]')];
          const sort = (dir) => {
            const lis = [...ol.children];
            lis.sort((a, b) => {
              const ka = a.dataset.key, kb = b.dataset.key;
              if (!ka && !kb) return 0; if (!ka) return 1; if (!kb) return -1; // undated hamesha neeche
              return dir === 'asc' ? ka.localeCompare(kb) : kb.localeCompare(ka);
            });
            lis.forEach((li, i) => {
              ol.appendChild(li);
              li.querySelector('.num').textContent = String(i + 1).padStart(2, '0'); // 01, 02, 03… naye order mein
            });
            btns.forEach((b) => b.classList.toggle('on', b.dataset.chSort === dir));
          };
          btns.forEach((b) => b.addEventListener('click', () => sort(b.dataset.chSort)));
          sort('asc');
        })();
      </script>
    </div>
  </section>

  <!-- ================= 5. CONSISTENCY ================= -->
  <section class="proof" id="consistency">
    <div class="wrap">
      <Consistency />
    </div>
  </section>

  <!-- ================= 6. PROJECTS (sticky stacking cards) ================= -->
  <section class="work" id="work">
    <div class="wrap">
      <h2 class="giant">Work</h2>
      <div class="stack" data-stack>
        {projects.map((p, i) => (
          <article class="pcard" style={`--i:${i};--a:${p.art[0]};--b:${p.art[1]}`}>
            <div class="pinfo">
              <span class="num">{p.n}</span>
              <p class="kind">{p.kind}</p>
              <h3>{p.name}</h3>
              <p class="pline">{p.line}</p>
              {p.links.length > 0 && (
                <div class="plinks">
                  {p.links.map(([label, href], j) => (
                    <a class:list={['btn', j === 0 ? 'primary' : 'ghost']} href={href} target="_blank" rel="noopener">{label} ↗</a>
                  ))}
                </div>
              )}
            </div>
            <div class="pvisual">
              <div class="pstats">
                {p.stats.map(([v, l]) => <div><b>{v}</b><span>{l}</span></div>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 7. CHAPTER CARDS (topics) ================= -->
  <section>
    <div class="wrap">
      <p class="kicker" data-reveal>Explore</p>
      <h2 class="section-title" data-reveal>Everything I am, <em class="sun">in chapters.</em></h2>
      <div class="topics">
        {topics.map((t, i) => <TopicCard topic={t} delay={(i % 3) * 0.08} />)}
      </div>
    </div>
  </section>

  <!-- ================= 8. LATEST ================= -->
  {latest.length > 0 && (
    <section>
      <div class="wrap">
        <p class="kicker" data-reveal>Latest entries</p>
        <div class="latest">
          {latest.map((e, i) => (
            <a class="card entry" href={`/journal/${e.id}/`} data-reveal style={`--d:${i * 0.08}s`}>
              <time datetime={e.id}>{fmt(e.data.date)}</time>
              <span>{e.data.title}</span>
              <i>Read →</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    (() => {
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (calm) return;
      // Project cards scale down slightly as the next one stacks over them
      const cards = [...document.querySelectorAll('[data-stack] .pcard')];
      let ticking = false;
      const update = () => {
        ticking = false;
        cards.forEach((card, i) => {
          const next = cards[i + 1];
          if (!next) return;
          const gap = next.getBoundingClientRect().top - card.getBoundingClientRect().top;
          const p = Math.min(1, Math.max(0, 1 - gap / card.offsetHeight));
          card.style.setProperty('--shrink', (1 - p * 0.06).toFixed(4));
          card.style.setProperty('--dim', (p * 0.45).toFixed(3));
        });
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('resize', update);
      update();
    })();
  </script>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ================= 1. HERO — dark, quiet, editorial ================= */
  .cine {
    --ink: #f3ece4; --muted: #b3a49a; --line: rgba(255,255,255,.1); --surface: rgba(255,255,255,.04);
    position: relative; isolation: isolate; overflow: hidden;
    min-height: calc(100svh - 76px); padding: 0; display: flex; align-items: center;
    background: radial-gradient(110% 70% at 70% 100%, #24110f 0%, #0e0b0a 62%); color: var(--ink);
  }
  .aurora { position: absolute; inset: 0 0 45% 0; z-index: -1; }
  .grain {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: .14; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; padding-block: clamp(56px, 8vw, 104px); width: 100%; }

  .issue { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 32px; font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; }
  .live { width: 6px; height: 6px; border-radius: 50%; background: #f0794c; box-shadow: 0 0 0 0 rgba(240,121,76,.6); animation: pulse 2.4s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  .name { margin: -.1em 0 10px; line-height: .95; }
  .name-row { display: flex; flex-wrap: wrap; gap: 0 .42em; white-space: nowrap; }
  .name :global(.name-a), .name :global(.name-b) { font: 400 clamp(3.4rem, 7.2vw, 6.6rem)/.95 'Fraunces', serif; letter-spacing: -.035em; color: #f3ece4; }
  .name :global(.name-b) { font-style: italic; color: #f0a07e; }
  /* SplitText apne wrapper par overflow:hidden lagata hai (inline style) — wo neeche ki poonch kaat deta hai.
     Har letter ka apna mask clipping sambhalta hai, isliye wrapper ko visible rakho. */
  .name :global(.split-parent) { overflow: visible !important; }
  /* Mask ko neeche jagah do taaki "y" aur "J" ki poonch (descender) na kate */
  .name :global(.split-char) { line-height: 1.22; }
  .name :global(.name-b .split-char-mask) { padding: 0 .14em; margin: 0 -.14em; }

  .tagline { margin: 0 0 18px; font: 400 clamp(1.2rem, 2vw, 1.6rem)/1.3 'Fraunces', serif; color: #e9ddd2; }
  .tagline em { color: #f0a07e; }
  .lead { margin: 0 0 34px; max-width: 470px; color: var(--muted); font-size: 1.02rem; line-height: 1.7; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .cine .btn { padding: 13px 22px; font-weight: 500; letter-spacing: .01em; }
  .cine .btn.primary { background: #f3ece4; color: #14100e; box-shadow: none; }
  .cine .btn.primary:hover { background: #fff; }
  .btn.ghost { background: transparent; color: #f3ece4; border-color: rgba(255,255,255,.2); }
  .btn.ghost:hover { border-color: rgba(255,255,255,.5); }

  .facts { display: flex; gap: clamp(24px, 4vw, 48px); margin: 48px 0 0; padding-top: 24px; border-top: 1px solid var(--line); max-width: 470px; }
  .facts dt { font: 400 2rem/1 'Fraunces', serif; color: #f3ece4; }
  .facts dd { margin: 6px 0 0; font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }

  .profile { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .portrait { position: relative; display: block; width: min(380px, 100%); aspect-ratio: 1; padding: 0; border: none; background: none; border-radius: 50%; cursor: zoom-in; }
  .portrait img { position: relative; z-index: 1; display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 8px solid #0e0b0a; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .portrait:hover img { transform: scale(1.015); }
  .halo { position: absolute; inset: -1px; border-radius: 50%; background: conic-gradient(from 210deg, #f08a4b, #e23d6d, #6b3a8f, #f08a4b); box-shadow: 0 40px 90px -30px rgba(226,61,109,.45); }
  .portrait:focus-visible { outline: 2px solid #f0a07e; outline-offset: 10px; }
  .hint { position: absolute; z-index: 2; left: 50%; bottom: 18px; transform: translate(-50%, 6px); font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #fff; background: rgba(14,11,10,.6); backdrop-filter: blur(8px); padding: 8px 14px; border-radius: 999px; opacity: 0; transition: opacity .3s, transform .3s; white-space: nowrap; }
  .portrait:hover .hint, .portrait:focus-visible .hint { opacity: 1; transform: translate(-50%, 0); }
  .profile :global(.socials) { --mono: #fff; justify-content: center; }
  .profile :global(.socials a) { background: rgba(255,255,255,.04); border-color: rgba(255,255,255,.12); }

  .lightbox { padding: 0; border: none; background: transparent; max-width: 92vw; max-height: 92vh; overflow: visible; }
  .lightbox::backdrop { background: rgba(10,8,7,.9); backdrop-filter: blur(8px); }
  .lightbox img { display: block; max-width: 92vw; max-height: 90vh; width: auto; height: auto; border-radius: 16px; box-shadow: 0 30px 80px rgba(0,0,0,.6); }
  .lightbox[open] { animation: pop .35s cubic-bezier(.2,.7,.2,1); }
  @keyframes pop { from { opacity: 0; transform: scale(.97); } }
  .close { position: absolute; top: -14px; right: -14px; z-index: 1; width: 38px; height: 38px; border-radius: 50%; border: none; background: #f3ece4; color: #14100e; font-size: 14px; cursor: pointer; box-shadow: 0 8px 20px rgba(0,0,0,.4); }

  /* ================= 3. STORY ================= */
  .story { padding-block: 120px; }
  .story :global(.story-text) { font: 300 clamp(1.7rem, 4.2vw, 3.4rem)/1.3 'Fraunces', serif; letter-spacing: -.02em; max-width: 1000px; }

  /* ================= 4. CHAPTERS — light panel ================= */
  .chapters { background: #f6f0e8; color: #1c1512; border-radius: 56px 56px 0 0; padding-block: 96px 140px; }
  .giant { font: italic 300 clamp(3.2rem, 10vw, 8.5rem)/.9 'Fraunces', serif; letter-spacing: -.04em; text-align: center; margin: 0 0 72px; color: inherit; }
  .chapters ol { list-style: none; margin: 0 auto; padding: 0; max-width: 980px; }
  .chapters li { display: grid; grid-template-columns: clamp(90px, 14vw, 170px) 1fr; align-items: center; gap: 24px; padding-block: 26px; border-top: 1px solid rgba(35,20,15,.14); }
  .chapters li:last-child { border-bottom: 1px solid rgba(35,20,15,.14); }
  .chapters .num { font: 300 clamp(2.4rem, 6vw, 4.6rem)/1 'Fraunces', serif; color: #1c1512; letter-spacing: -.03em; transition: color .3s; }
  .chapters li:hover .num { color: #c2552f; }
  .chapters h3 time, .chapters .nodate { margin-left: 14px; padding: 3px 10px; border-radius: 999px; font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .08em; text-transform: none; vertical-align: middle; }
  .chapters h3 time { color: #c2552f; border: 1px solid rgba(194,85,47,.35); }
  .chapters .nodate { color: #9a8a80; border: 1px dashed rgba(35,20,15,.2); }
  .ch-sort { display: flex; justify-content: center; gap: 4px; width: max-content; margin: -36px auto 40px; padding: 4px; border-radius: 999px; border: 1px solid rgba(35,20,15,.14); background: #fffaf4; }
  .ch-sort button { border: none; background: none; color: #7a6a62; font: 600 13px 'Inter', sans-serif; padding: 8px 16px; border-radius: 999px; cursor: pointer; }
  .ch-sort button.on { background: #1c1512; color: #f6f0e8; }
  .ch-sort button:focus-visible { outline: 2px solid #c2552f; outline-offset: 2px; }
  .chapters h3 { margin: 0 0 6px; font: 500 clamp(.85rem, 1.2vw, 1rem)/1.1 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .2em; }
  .chapters p { margin: 0; color: #4a3d36; font: 400 clamp(1.1rem, 2vw, 1.5rem)/1.35 'Fraunces', serif; }

  /* ================= 5. PROOF — dark panel pulled over the light one ================= */
  .proof { position: relative; z-index: 1; margin-top: -56px; border-radius: 56px 56px 0 0; background: var(--bg); }

  /* ================= 6. WORK — sticky stacking cards ================= */
  .stack { display: grid; gap: 40px; padding-bottom: 6vh; }
  .pcard {
    position: sticky; top: calc(96px + var(--i) * 26px);
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 28px; align-items: stretch;
    min-height: 420px; padding: clamp(20px, 3vw, 36px); border-radius: clamp(28px, 4vw, 48px);
    background: var(--surface); border: 1.5px solid var(--line); box-shadow: var(--shadow);
    transform: scale(var(--shrink, 1)); transform-origin: center top;
  }
  .pcard::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: #000; opacity: var(--dim, 0); pointer-events: none; }
  .pinfo { display: flex; flex-direction: column; }
  .pinfo .num { font: 300 clamp(2.6rem, 6vw, 4.6rem)/1 'Fraunces', serif; background: linear-gradient(135deg, var(--a), var(--b)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .kind { margin: 8px 0 4px; font: 500 12px 'JetBrains Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .pinfo h3 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.6vw, 2.8rem); }
  .pline { margin: 0 0 22px; color: var(--muted); font-size: 1.05rem; max-width: 460px; }
  .plinks { display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto; }
  .pvisual { position: relative; border-radius: clamp(22px, 3vw, 36px); overflow: hidden; background: linear-gradient(140deg, var(--a), var(--b)); padding: 18px; display: flex; align-items: flex-end; }
  .pvisual::before { content: ''; position: absolute; width: 340px; height: 340px; right: -110px; top: -120px; border-radius: 50%; border: 2px solid rgba(255,255,255,.3); }
  .pstats { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
  .pstats div { background: rgba(255,255,255,.16); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.25); border-radius: 18px; padding: 14px 16px; color: #fff; }
  .pstats b { display: block; font: 700 clamp(1.4rem, 2.6vw, 2rem)/1 'Fraunces', serif; margin-bottom: 4px; }
  .pstats span { font-size: .82rem; opacity: .9; }

  /* ================= 7–8 ================= */
  .topics { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-flow: dense; gap: 18px; margin-top: 34px; }
  .latest { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .entry { display: flex; flex-direction: column; gap: 8px; color: var(--ink); font: 600 1.15rem/1.3 'Fraunces', serif; }
  .entry:hover { text-decoration: none; border-color: var(--accent); }
  .entry time { font: 500 12px 'JetBrains Mono', monospace; color: var(--accent); }
  .entry i { font: 500 13px 'Inter', sans-serif; color: var(--muted); margin-top: auto; }

  @media (prefers-reduced-motion: reduce) { .live, .lightbox[open] { animation: none; } }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr 0.9fr; gap: 36px; }
    .topics { grid-template-columns: repeat(2, 1fr); }
    .pcard { grid-template-columns: 1fr; min-height: 0; }
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; gap: 44px; padding-block: 48px 64px; }
    .profile { order: -1; }
    .portrait { width: min(250px, 68vw); }
    .profile :global(.socials) { gap: 7px; flex-wrap: nowrap; }
    .profile :global(.socials a) { width: 44px; height: 44px; }
    .facts { gap: 28px; }
    .topics { grid-template-columns: 1fr; }
    .chapters, .proof { border-radius: 36px 36px 0 0; }
    .chapters li { grid-template-columns: 72px 1fr; gap: 14px; }
    .pcard { top: calc(84px + var(--i) * 16px); }
  }
</style>
