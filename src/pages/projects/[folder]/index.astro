---
// Ek project folder ke andar: saare documents ek list mein (padhne ke liye click).
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { folders } from '../../../data/projects';

export async function getStaticPaths() {
  const docs = await getCollection('projects');
  return folders.map((f) => ({
    params: { folder: f.slug },
    props: { f, files: docs.filter((d) => d.id.split('/')[0] === f.slug).sort((a, b) => a.data.order - b.data.order) },
  }));
}
const { f, files } = Astro.props;
const statusLabel = { live: 'Live', building: 'In progress', archived: 'Archived' };
const docStatus = { ready: '', draft: 'Draft', planned: 'Coming soon' };
const fmt = (d?: Date) => d?.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title={f.name} description={`${f.name} — ${f.line}`}>
  <section class="wrap top" style={`--c1:${f.tone[0]};--c2:${f.tone[1]}`}>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/projects/">Projects</a><span>/</span><b>{f.name}</b></nav>
    <div class="label">
      <span class="tab" aria-hidden="true"></span>
      <p class="f-kind">{f.kind}</p>
      <h1>{f.name}</h1>
      <p class="line">{f.line}</p>
      <div class="meta">
        <span class={`dot ${f.status}`}></span>{statusLabel[f.status]}
        <span class="sep">·</span>{files.length} documents
      </div>
      <div class="chips">{f.tags.map((t) => <span class="pill">{t}</span>)}</div>
      {f.links && <div class="links">{f.links.map(([label, href]) => <a class="btn" href={href} target="_blank" rel="noopener">{label} ↗</a>)}</div>}
    </div>
  </section>

  <section class="wrap files" aria-label="Documents">
    <ol>
      {files.map((d) => {
        const slug = d.id.split('/').slice(1).join('/');
        return (
          <li class:list={[d.data.status]}>
            <a href={`/projects/${f.slug}/${slug}/`}>
              <span class="n">{String(d.data.order).padStart(2, '0')}</span>
              <span class="body">
                <span class="k">{d.data.kind}{d.data.version && ` · v${d.data.version}`}{docStatus[d.data.status] && <em>{docStatus[d.data.status]}</em>}</span>
                <span class="t">{d.data.title}</span>
                <span class="s">{d.data.summary}</span>
              </span>
              <span class="when">{fmt(d.data.updated)}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
</Base>

<style>
  .top { padding-block: 48px 20px; }
  .crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--muted); margin-bottom: 26px; }
  .crumbs b { color: var(--ink); font-weight: 500; }
  .label { position: relative; padding: 36px 36px 30px; border-radius: 6px 22px 22px 22px; color: #f6efe6;
    background: radial-gradient(120% 90% at 0% 0%, rgba(255, 255, 255, .09), transparent 55%), linear-gradient(160deg, var(--c1), color-mix(in srgb, var(--c1) 70%, #000));
    box-shadow: var(--shadow); margin-top: 22px; }
  .label::before { content: ''; position: absolute; inset: 10px; border: 1px dashed rgba(255, 255, 255, .13); border-radius: 14px; pointer-events: none; }
  .tab { position: absolute; left: 0; top: -20px; width: min(240px, 46%); height: 22px; border-radius: 12px 14px 0 0; background: var(--c1); clip-path: polygon(0 0, 88% 0, 100% 100%, 0 100%); }
  .f-kind { margin: 0 0 10px; font: 500 11px/1 'JetBrains Mono', monospace; letter-spacing: .2em; text-transform: uppercase; color: color-mix(in srgb, var(--c2) 70%, #fff); }
  h1 { margin: 0 0 12px; font-size: clamp(2.1rem, 5.5vw, 3.4rem); }
  .line { margin: 0 0 16px; max-width: 60ch; color: rgba(246, 239, 230, .78); }
  .meta { display: flex; align-items: center; gap: 7px; font: 500 12px 'JetBrains Mono', monospace; color: rgba(246, 239, 230, .65); margin-bottom: 16px; }
  .sep { opacity: .5; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #9a8f86; }
  .dot.live { background: #6fd39b; box-shadow: 0 0 0 3px rgba(111, 211, 155, .18); }
  .dot.building { background: #f0b24c; box-shadow: 0 0 0 3px rgba(240, 178, 76, .18); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips .pill { background: rgba(255, 255, 255, .08); border-color: rgba(255, 255, 255, .14); color: #f6efe6; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; position: relative; }
  .btn { padding: 9px 16px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .25); color: #f6efe6; font-size: 14px; font-weight: 500; }
  .btn:hover { text-decoration: none; border-color: var(--c2); background: rgba(255, 255, 255, .06); }

  .files { padding-block: 26px 88px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  li a { display: grid; grid-template-columns: 54px minmax(0, 1fr) auto 24px; gap: 18px; align-items: center; padding: 20px 22px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); color: var(--ink); box-shadow: var(--shadow); transition: border-color .2s, transform .25s; }
  li a:hover { text-decoration: none; border-color: color-mix(in srgb, var(--accent) 60%, var(--line)); transform: translateX(4px); }
  .n { font: 400 1.9rem/1 'Fraunces', serif; color: var(--muted); }
  .body { display: grid; gap: 4px; min-width: 0; }
  .k { display: flex; gap: 10px; align-items: center; font: 500 10.5px/1 'JetBrains Mono', monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
  .k em { font-style: normal; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 3px 8px; letter-spacing: .1em; }
  .t { font: 500 1.2rem/1.25 'Fraunces', serif; }
  .s { font-size: .92rem; color: var(--muted); }
  .when { font: 500 11.5px 'JetBrains Mono', monospace; color: var(--muted); white-space: nowrap; }
  .go { color: var(--muted); transition: color .2s; }
  li a:hover .go { color: var(--accent); }
  li.planned a { background: transparent; border-style: dashed; box-shadow: none; }
  li.planned .t, li.planned .n { color: var(--muted); }

  @media (max-width: 640px) {
    .top { padding-block: 32px 12px; }
    .label { padding: 28px 22px 24px; }
    li a { grid-template-columns: 34px minmax(0, 1fr); gap: 12px; padding: 16px; align-items: start; }
    .n { font-size: 1.4rem; }
    .when, .go { display: none; }
  }
</style>
