---
// Ek document ka page: /projects/<folder>/<doc>/ — left mein "Contents" (headings), right mein padhne wala text.
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { folders } from '../../../data/projects';

export async function getStaticPaths() {
  const docs = await getCollection('projects');
  return folders.flatMap((f) => {
    const files = docs.filter((d) => d.id.split('/')[0] === f.slug).sort((a, b) => a.data.order - b.data.order);
    return files.map((d, i) => ({
      params: { folder: f.slug, doc: d.id.split('/').slice(1).join('/') },
      props: { f, d, prev: files[i - 1], next: files[i + 1] },
    }));
  });
}
const { f, d, prev, next } = Astro.props;
const { Content, headings } = await render(d);
const toc = headings.filter((h) => h.depth === 2);
const href = (x: typeof d) => `/projects/${f.slug}/${x.id.split('/').slice(1).join('/')}/`;
const when = d.data.updated?.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${d.data.title} — ${f.name}`} description={d.data.summary}>
  <article class="wrap doc" style={`--c2:${f.tone[1]}`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/projects/">Projects</a><span>/</span><a href={`/projects/${f.slug}/`}>{f.name}</a><span>/</span><b>{d.data.kind}</b>
    </nav>

    <header>
      <p class="kicker">{d.data.kind}{d.data.version && ` · Version ${d.data.version}`}{when && ` · ${when}`}</p>
      <h1>{d.data.title}</h1>
      <p class="lead">{d.data.summary}</p>
      {d.data.status !== 'ready' && (
        <p class="notice">{d.data.status === 'planned' ? 'Coming soon — this document will be written as the project moves forward. Below is what it will cover.' : 'Draft — still being written.'}</p>
      )}
    </header>

    <div class:list={['grid', { solo: toc.length < 3 }]}>
      {toc.length >= 3 && (
        <aside class="toc">
          <details open>
            <summary>Contents</summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        </aside>
      )}
      <div class="prose paper"><Content /></div>
    </div>

    <nav class="pager" aria-label="More documents">
      {prev ? <a class="card" href={href(prev)}><span class="muted">← {prev.data.kind}</span>{prev.data.title}</a> : <a class="card" href={`/projects/${f.slug}/`}><span class="muted">← Folder</span>{f.name}</a>}
      {next ? <a class="card right" href={href(next)}><span class="muted">{next.data.kind} →</span>{next.data.title}</a> : <a class="card right" href="/projects/"><span class="muted">All projects →</span>Projects</a>}
    </nav>
  </article>
</Base>

<script is:inline>
  // TOC: highlight the section you're reading; on phones the list starts closed.
  (function () {
    var toc = document.querySelector('.toc');
    if (!toc) return;
    if (matchMedia('(max-width: 900px)').matches) toc.querySelector('details').removeAttribute('open');
    var links = [].slice.call(toc.querySelectorAll('a'));
    var map = new Map(links.map(function (a) { return [decodeURIComponent(a.hash.slice(1)), a]; }));
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (a) { a.classList.remove('on'); });
        var a = map.get(e.target.id); if (a) a.classList.add('on');
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.paper h2[id]').forEach(function (h) { io.observe(h); });
  })();
</script>

<style>
  .doc { padding-block: 40px 88px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--muted); }
  .crumbs b { color: var(--ink); font-weight: 500; }
  header { max-width: 820px; padding: 34px 0 30px; border-bottom: 1px solid var(--line); margin-bottom: 36px; }
  h1 { font-size: clamp(2.1rem, 5.4vw, 3.3rem); margin: 0 0 14px; }
  .lead { margin: 0; font-size: 1.1rem; color: var(--muted); max-width: 64ch; }
  .notice { margin: 20px 0 0; padding: 12px 16px; border-radius: 12px; border: 1px dashed color-mix(in srgb, var(--accent) 50%, var(--line)); background: var(--accent-soft); font-size: .94rem; }

  .grid { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 56px; align-items: start; }
  .grid.solo { grid-template-columns: minmax(0, 1fr); }
  .toc { position: sticky; top: 96px; max-height: calc(100vh - 120px); overflow-y: auto; }
  .toc summary { font: 500 11px/1 'JetBrains Mono', monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); cursor: pointer; list-style: none; padding: 4px 0 14px; }
  .toc summary::-webkit-details-marker { display: none; }
  .toc ol { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 1px solid var(--line); display: grid; gap: 2px; }
  .toc a { display: block; padding: 5px 0; font-size: .88rem; line-height: 1.35; color: var(--muted); }
  .toc a:hover { color: var(--ink); text-decoration: none; }
  .toc a.on { color: var(--accent); }

  .paper { max-width: 760px; min-width: 0; }
  .paper :global(h2) { scroll-margin-top: 96px; padding-top: .4em; border-top: 1px solid var(--line); }
  .paper :global(h2:first-child) { border-top: none; margin-top: 0; }
  .paper :global(h3) { scroll-margin-top: 96px; }
  .paper :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.4em; font-size: .92rem; }
  .paper :global(th), .paper :global(td) { text-align: left; vertical-align: top; padding: 9px 14px 9px 0; border-bottom: 1px solid var(--line); }
  .paper :global(th) { font: 500 10.5px/1.3 'JetBrains Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .paper :global(td:first-child) { min-width: 4.2em; }
  .paper :global(td) { overflow-wrap: break-word; }
  .paper :global(:not(pre) > code) { overflow-wrap: anywhere; }
  .paper :global(pre) { font-size: .84rem; line-height: 1.5; }
  .paper :global(hr) { border: none; border-top: 1px solid var(--line); margin: 2em 0; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; color: var(--ink); font-weight: 600; }
  .pager a:hover { text-decoration: none; border-color: var(--accent); }
  .pager .right { text-align: right; }
  .pager span.muted { font-size: 13px; font-weight: 500; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .toc { position: static; max-height: none; padding: 14px 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
    .toc summary { padding: 0; }
    .toc details[open] summary { padding-bottom: 12px; }
  }
  @media (max-width: 640px) {
    .doc { padding-block: 28px 64px; }
    header { padding: 24px 0 22px; margin-bottom: 24px; }
    .pager { grid-template-columns: 1fr; }
    .pager .right { text-align: left; }
    .paper :global(table) { font-size: .86rem; }
    .paper :global(th), .paper :global(td) { padding-right: 10px; }
  }
</style>
