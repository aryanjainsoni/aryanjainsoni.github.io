---
// GYM — two tabs: Steps (live from the Daily Log) and Diet plan (being built).
// Steps flow: phone's Fit/Health app -> Daily Log "Steps today" -> journal frontmatter `steps:` -> this page.
// (Automatic phone sync isn't possible on a free static site — Google Fit's web API is being shut down
//  and Health Connect only works inside Android apps.)
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import { site } from '../data/site';
import { getEntries } from '../lib/journal';
import { stepStats, milestones, KM_PER_STEP, KCAL_PER_STEP } from '../lib/steps';
import '../styles/fit.css';
import GuideVisual from '../components/GuideVisual.astro';
import { getCollection, render } from 'astro:content';

// Gym Notebook chapters (src/content/guide/*.md)
const chapters = await Promise.all((await getCollection('guide')).sort((a, b) => a.data.n - b.data.n).map(async (e) => ({ e, Content: (await render(e)).Content })));
const lastUpdate = chapters.reduce((m, c) => (c.e.data.updated > m ? c.e.data.updated : m), new Date(0));
const fmtLong = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// Gym tabs: [id, label, media name, tint, SVG glyph]
const orbs: [string, string, string, string, string][] = [
  ['steps', 'Steps', 'steps', '#7aa7ff', '<path d="M8.5 3.5c1.7 0 2.5 1.8 2.5 4s-1 3.6-2.6 3.6S6 9.8 6 7.6 6.8 3.5 8.5 3.5Z"/><path d="M6.6 13.4h3.8l-.3 2.3a1.9 1.9 0 0 1-3.8 0Z"/><path d="M15.5 8.5c1.7 0 2.5 1.8 2.5 4s-1 3.6-2.6 3.6-2.4-1.3-2.4-3.5.8-4.1 2.5-4.1Z"/><path d="M13.6 18.4h3.8l-.3 2.3a1.9 1.9 0 0 1-3.8 0Z"/>'],
  ['today', 'Today', 'today', '#ffc46b', '<path d="M3 17.5h18"/><path d="M7 17.5a5 5 0 0 1 10 0"/><path d="M12 6v3M5.6 9.1l2 2M18.4 9.1l-2 2"/><path d="M8.5 20.5h7"/>'],
  ['plan', 'Plan', 'plan', '#d9dee8', '<rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M8 14h2M14 14h2M8 17h2"/>'],
  ['diet', 'Diet', 'diet', '#ff9ec4', '<path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-7 10-9"/>'],
  ['body', 'Body', 'body', '#e9a64f', '<path d="M6.5 7v10M17.5 7v10M3.5 9.5v5M20.5 9.5v5M6.5 12h11"/>'],
  ['guide', 'Notebook', 'notebook', '#f3efe6', '<path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5Z"/><path d="M12 6.5v13"/>'],
];

// Music loudness: each track measured (RMS) and scaled to the same quiet background level (~ -31 dBFS RMS)
const gains: Record<string, number> = { steps: 0.108, today: 0.26, plan: 0.089, diet: 0.11, body: 0.197, notebook: 0.224 };

const goal = site.stepGoal;
const s = stepStats(await getEntries(), goal);
const n = (x: number) => Math.round(x).toLocaleString('en-IN');
const fmtDay = (k: string) => new Date(k).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });

// Hero ring: today if logged, else the last logged day
const shown = s.last;
const isToday = shown?.d === s.today;
const pct = shown ? Math.min(shown.n / goal, 1) : 0;
const R = 88, C = 2 * Math.PI * R;

// Lifetime milestone progress
const next = milestones.find((m) => m.km > s.km);
const prev = [...milestones].reverse().find((m) => m.km <= s.km);
const mPct = next ? Math.min(100, ((s.km - (prev?.km ?? 0)) / (next.km - (prev?.km ?? 0))) * 100) : 100;

const wdMax = Math.max(...s.weekday, 1);
const wdNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const bestWd = s.weekday.some(Boolean) ? wdNames[s.weekday.indexOf(Math.max(...s.weekday))] : '';
---
<Base title="Gym" description="Aryan Jain's fitness log — daily steps, streaks and the diet plan behind the training.">
  <section class="head">
    <div class="wrap">
      <p class="kicker">Gym</p>
      <h1>Strength is a <em>daily habit.</em></h1>
      <p class="lead">Every step logged, every day counted. Training since 2025 — this is the quiet part of the work.</p>
      <!-- Round live-video icons: 3D loop (MotionSites free backgrounds) + glass + symbol. Each tab has its own colour and music. -->
      <div class="orbbar">
        <div class="tabs orbs" role="tablist" aria-label="Gym sections">
          {orbs.map(([id, label, vid, tint, glyph], i) => (
            <button role="tab" id={`tab-${id}`} aria-controls={`p-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={id} data-track={vid} data-gain={gains[vid]} style={`--tint:${tint}`}>
              <span class="orb" aria-hidden="true">
                <video muted loop playsinline preload="none" poster={`/videos/gym/${vid}.jpg`} data-src={`/videos/gym/${vid}.mp4`}></video>
                <svg class="glyph" viewBox="0 0 24 24" set:html={glyph} />
              </span>
              <span class="orb-label">{label}</span>
            </button>
          ))}
        </div>
        <button type="button" class="sound" id="gym-sound" aria-pressed="false" aria-label="Music off — turn on" title="Background music (each tab has its own)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="note" d="M9 18.5V6.5l10-2.5v12"/><circle class="note" cx="6.5" cy="18.5" r="2.5"/><circle class="note" cx="16.5" cy="16" r="2.5"/><path class="slash" d="M3.5 3.5l17 17"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ================= STEPS ================= -->
  <section class="panel" id="p-steps" role="tabpanel" aria-labelledby="tab-steps">
    <div class="wrap">
      <div class="top">
        <div class="card today">
          <div class="ring" style={`--p:${pct}`}>
            <svg viewBox="0 0 200 200" aria-hidden="true">
              <defs>
                <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#f08a4b" /><stop offset=".55" stop-color="#e2552f" /><stop offset="1" stop-color="#e23d6d" />
                </linearGradient>
              </defs>
              <circle cx="100" cy="100" r={R} class="track" />
              <circle cx="100" cy="100" r={R} class="bar" stroke-dasharray={C} stroke-dashoffset={C * (1 - pct)} />
            </svg>
            <div class="center">
              <p class="rl">{shown ? (isToday ? 'Today' : fmtDay(shown.d)) : 'Today'}</p>
              <b>{shown ? n(shown.n) : '—'}</b>
              <p class="rg">of {n(goal)} steps</p>
            </div>
          </div>
          <div class="facts">
            {shown ? (
              <>
                <span><i>{Math.round(pct * 100)}%</i> of goal</span>
                <span><i>≈ {(shown.n * KM_PER_STEP).toFixed(1)}</i> km</span>
                <span><i>≈ {n(shown.n * KCAL_PER_STEP)}</i> kcal</span>
              </>
            ) : <span class="muted">No steps logged yet — the first one lands tonight.</span>}
          </div>
          {shown && !isToday && <p class="fine center-t">Today isn’t logged yet — showing the last logged day.</p>}
        </div>

        <div class="tiles">
          <div class="tile"><span class="e" aria-hidden="true">🔥</span><b>{s.goalStreak.current}</b><span>day 10k streak</span></div>
          <div class="tile"><span class="e" aria-hidden="true">📈</span><b>{s.avg7 ? n(s.avg7) : '—'}</b><span>7-day average</span></div>
          <div class="tile"><span class="e" aria-hidden="true">🏆</span><b>{s.best ? n(s.best.n) : '—'}</b><span>{s.best ? `best · ${fmtDay(s.best.d)}` : 'best day'}</span></div>
          <div class="tile"><span class="e" aria-hidden="true">🎯</span><b>{s.goalDays}<small>/{s.days.length}</small></b><span>days hit goal</span></div>
        </div>
      </div>

      <div class="card chart">
        <div class="chead">
          <div>
            <p class="label">Daily steps</p>
            <h2 data-range-title>Last 30 days</h2>
          </div>
          <div class="seg" role="group" aria-label="Chart range">
            <button data-range="7">7D</button>
            <button data-range="30" class="on">30D</button>
            <button data-range="90">90D</button>
            <button data-range="365">1Y</button>
          </div>
        </div>
        <div class="plotwrap">
          <div class="plot" data-plot aria-label="Bar chart of daily steps"></div>
          <div class="tip" data-tip hidden></div>
        </div>
        <div class="sum">
          <div><p class="sk">Average</p><p class="sv" data-sum="avg">—</p></div>
          <div><p class="sk">Total</p><p class="sv" data-sum="total">—</p></div>
          <div><p class="sk">Goal days</p><p class="sv" data-sum="hit">—</p></div>
          <div><p class="sk">Vs previous</p><p class="sv" data-sum="delta">—</p></div>
        </div>
      </div>

      <div class="duo">
        <div class="card rhythm">
          <p class="label">Weekly rhythm</p>
          <h3>{bestWd ? <>I walk most on <em>{bestWd}</em>.</> : 'Average by weekday'}</h3>
          <div class="wd">
            {s.weekday.map((v, i) => (
              <div class="wdc" title={v ? `${wdNames[i]} · avg ${n(v)} steps` : `${wdNames[i]} · no data`}>
                <div class="wdt"><span class:list={['wdb', { hit: v >= goal }]} style={`height:${(v / wdMax) * 100}%`}></span></div>
                <span class="wdl">{wdNames[i][0]}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="card journey">
          <p class="label">Lifetime distance</p>
          <p class="big"><b>{s.km < 10 ? s.km.toFixed(1) : n(s.km)}</b> km</p>
          <p class="muted sub">{n(s.total)} steps since day one{prev && <> · past <b>{prev.name}</b></>}</p>
          {next && (
            <div class="mile">
              <div class="mtop"><span>Next: {next.name}</span><span>{n(next.km)} km</span></div>
              <div class="mbar"><span style={`width:${mPct}%`}></span></div>
              <p class="fine">{(next.km - s.km).toFixed(next.km - s.km < 10 ? 1 : 0)} km to go</p>
            </div>
          )}
        </div>
      </div>

      <div class="card year">
        <div class="chead">
          <div><p class="label">The year</p><h2>Every day, in steps</h2></div>
          <p class="muted small">Darkest = {n(goal)}+ steps. Logging streak: <b>{s.logStreak.current}</b> days (best {s.logStreak.longest}).</p>
        </div>
        <Heatmap byDay={s.levels} labels={s.labels} empty="not logged" />
      </div>

      <div class="how">
        <p><b>How this works.</b> Each night I read the count from my phone’s health app and log it in the <a href="/log/">Daily Log</a>. It’s manual on purpose: free, private, and one honest number a day.</p>
        <a class="btn ghost" href="/log/#f-steps">+ Log today’s steps</a>
      </div>
    </div>
  </section>

  <!-- ================= PRIVATE: TODAY · PLAN · DIET · BODY (rendered in the browser from localStorage) ================= -->
  {['today', 'plan', 'diet', 'body'].map((id) => (
    <section class="panel fit" id={`p-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} hidden>
      <div class="wrap" data-fit={id}><p class="muted">Loading…</p></div>
    </section>
  ))}

  <!-- ================= NOTEBOOK (public guidelines) ================= -->
  <section class="panel" id="p-guide" role="tabpanel" aria-labelledby="tab-guide" hidden>
    <div class="wrap nb">
      <header class="nb-head">
        <p class="label">Gym notebook · {chapters.length} chapters · updated {fmtLong(lastUpdate)}</p>
        <h2>The rules I train <em>by.</em></h2>
        <p class="nb-lead">Evidence-based guidelines for fat loss, muscle and a lean V-shape — written down, sourced, and updated as I learn.</p>
        <nav class="nb-toc" aria-label="Chapters">
          {chapters.map(({ e }) => <a href={`#nb-${e.id}`}><span>{String(e.data.n).padStart(2, '0')}</span>{e.data.icon} {e.data.title}</a>)}
        </nav>
      </header>
      {chapters.map(({ e, Content }) => (
        <article class="nb-page" id={`nb-${e.id}`}>
          <div class="nb-top">
            <span class="nb-n">{String(e.data.n).padStart(2, '0')}</span>
            <span class="nb-icon" aria-hidden="true">{e.data.icon}</span>
            <span class="nb-date">updated {fmtLong(e.data.updated)}</span>
          </div>
          <h3>{e.data.title}</h3>
          <p class="nb-sum">{e.data.summary}</p>
          {e.data.visual && <GuideVisual name={e.data.visual} />}
          {e.data.caption && <p class="nb-cap">{e.data.caption}</p>}
          <div class="nb-body"><Content /></div>
          {e.data.sources.length > 0 && (
            <details class="nb-src"><summary>Sources ({e.data.sources.length})</summary>
              <ul>{e.data.sources.map((x) => <li><a href={x.url} target="_blank" rel="noopener">{x.title} ↗</a></li>)}</ul>
            </details>
          )}
        </article>
      ))}
      <p class="nb-foot">General guidance for healthy adults, not medical advice. Each chapter lives in <code>src/content/guide/</code> — add a file to add a chapter.</p>
    </div>
  </section>

  <script is:inline type="application/json" id="steps-data" set:html={JSON.stringify({ goal, today: s.today, days: s.days })}></script>
  <script is:inline>
    (() => {
      const D = JSON.parse(document.getElementById('steps-data').textContent);
      const map = new Map(D.days.map((x) => [x.d, x.n]));
      const goal = D.goal;
      const fmt = (x) => Math.round(x).toLocaleString('en-IN');
      const key = (d) => d.toISOString().slice(0, 10);
      const day = (k, o) => new Date(k).toLocaleDateString('en-IN', { timeZone: 'UTC', ...o });

      // ---------- live video orbs: all loop while on screen; hover = bigger, brighter, faster ----------
      const sysCalm = matchMedia('(prefers-reduced-motion: reduce)').matches || navigator.connection?.saveData;
      const calmNow = () => sysCalm || localStorage.getItem('pref:motion') === 'off'; // Settings → Live video icons
      const vidOf = (t) => t.querySelector('video');
      const play = (v) => { if (calmNow() || !v) return; if (!v.src) v.src = v.dataset.src; v.play().catch(() => {}); };
      const orbPlay = () => { soundSwitch(); };
      const startOrbs = () => document.querySelectorAll('.orbs video').forEach(play);
      addEventListener('ascent:motion', () => document.querySelectorAll('.orbs video').forEach((v) => (calmNow() ? v.pause() : play(v))));
      if (!sysCalm) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target; if (e.isIntersecting) play(v); else v.pause(); }), { threshold: 0.1 });
        document.querySelectorAll('.orbs video').forEach((v) => io.observe(v));
        document.addEventListener('visibilitychange', () => { if (!document.hidden) startOrbs(); });
      }

      // ---------- per-tab background music (off by default; crossfades when you switch tabs) ----------
      const soundBtn = document.getElementById('gym-sound');
      let actx = null, master = null, nowTrack = null, soundOn = localStorage.getItem('gym:sound') === 'on';
      const tracks = {};
      // fixed background level + limiter, so no track (or loud moment) ever jumps out
      const ensureCtx = () => {
        if (!actx) {
          actx = new (window.AudioContext || window.webkitAudioContext)();
          master = actx.createGain(); master.gain.value = 1;
          const lim = actx.createDynamicsCompressor();
          lim.threshold.value = -34; lim.knee.value = 8; lim.ratio.value = 10; lim.attack.value = 0.01; lim.release.value = 0.35;
          master.connect(lim); lim.connect(actx.destination);
        }
        if (actx.state === 'suspended') actx.resume();
      };
      const gainOf = (name) => Number(tabs.find((t) => t.dataset.track === name)?.dataset.gain) || 0.12;
      const trackFor = (name) => {
        if (tracks[name]) return tracks[name];
        const el = new Audio(`/audio/gym/${name}.m4a`); el.loop = true; el.preload = 'auto';
        const g = actx.createGain(); g.gain.value = 0; actx.createMediaElementSource(el).connect(g); g.connect(master);
        return (tracks[name] = { el, g });
      };
      const fade = (t, to, sec) => { const now = actx.currentTime; t.g.gain.cancelScheduledValues(now); t.g.gain.setValueAtTime(t.g.gain.value, now); t.g.gain.linearRampToValueAtTime(to, now + sec); };
      const activeTrack = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset.track;
      function soundSwitch() {
        if (!soundOn || !actx) return;
        const name = activeTrack(); if (!name || name === nowTrack) return;
        if (nowTrack && tracks[nowTrack]) { const old = tracks[nowTrack]; fade(old, 0, 1.2); setTimeout(() => { if (nowTrack !== old.name) old.el.pause(); }, 1300); old.name = nowTrack; }
        const t = trackFor(name); t.name = name; t.el.play().catch(() => {}); fade(t, gainOf(name), 1.6); nowTrack = name;
      }
      const setSoundUi = () => { soundBtn.setAttribute('aria-pressed', String(soundOn)); soundBtn.setAttribute('aria-label', soundOn ? 'Music on — turn off' : 'Music off — turn on'); soundBtn.classList.toggle('on', soundOn); };
      const soundStop = () => { Object.values(tracks).forEach((t) => { fade(t, 0, 0.8); setTimeout(() => t.el.pause(), 900); }); nowTrack = null; };
      const setSound = (on) => {
        soundOn = on; localStorage.setItem('gym:sound', soundOn ? 'on' : 'off'); setSoundUi();
        if (soundOn) { ensureCtx(); soundSwitch(); } else if (actx) soundStop();
        dispatchEvent(new Event('ascent:music-state')); // keep the Settings switch in sync
      };
      soundBtn.addEventListener('click', () => setSound(!soundOn));
      addEventListener('ascent:music', (e) => setSound(!!e.detail)); // Settings → Background music
      // remembered "on": browsers only allow audio after a tap/click, so start on the first interaction
      if (soundOn) { const go = () => { ensureCtx(); soundSwitch(); removeEventListener('pointerdown', go); removeEventListener('keydown', go); }; addEventListener('pointerdown', go); addEventListener('keydown', go); }
      document.addEventListener('visibilitychange', () => { if (!actx) return; if (document.hidden) actx.suspend(); else if (soundOn) actx.resume(); });
      setSoundUi();

      // ---------- tabs ----------
      const tabs = [...document.querySelectorAll('[data-tab]')];
      const show = (name, focus) => {
        tabs.forEach((t) => {
          const on = t.dataset.tab === name;
          t.setAttribute('aria-selected', on); t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
          if (on && focus) t.focus();
        });
        if (!location.hash.startsWith('#nb-')) history.replaceState(null, '', name === 'steps' ? location.pathname : '#' + name);
        document.querySelector('.head')?.classList.toggle('compact', name !== 'steps');
        orbPlay();
        if (name === 'steps') draw();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(t.dataset.tab));
        t.addEventListener('pointerenter', () => { const v = vidOf(t); play(v); if (v) v.playbackRate = 1.6; });
        t.addEventListener('pointerleave', () => { const v = vidOf(t); if (v) v.playbackRate = 1; });
        t.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          const j = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          show(tabs[j].dataset.tab, true);
        });
      });

      // ---------- chart ----------
      const plot = document.querySelector('[data-plot]');
      const tip = document.querySelector('[data-tip]');
      let range = 30;

      // range -> list of { k, n, label } (1Y = weekly averages)
      const series = (r, offset = 0) => {
        const end = new Date(D.today); end.setUTCDate(end.getUTCDate() - offset);
        const out = [];
        for (let i = r - 1; i >= 0; i--) { const d = new Date(end); d.setUTCDate(d.getUTCDate() - i); const k = key(d); out.push({ k, n: map.get(k) }); }
        return out;
      };
      const weekly = (list) => {
        const out = [];
        for (let i = 0; i < list.length; i += 7) {
          const w = list.slice(i, i + 7), got = w.filter((x) => x.n != null);
          out.push({ k: w[0].k, k2: w[w.length - 1].k, n: got.length ? got.reduce((s, x) => s + x.n, 0) / got.length : undefined, week: true });
        }
        return out;
      };
      const summary = (list) => {
        const got = list.filter((x) => x.n != null);
        const total = got.reduce((s, x) => s + x.n, 0);
        return { got, total, avg: got.length ? total / got.length : 0, hit: got.filter((x) => x.n >= goal).length };
      };

      function draw() {
        if (!plot.offsetParent) return;
        const raw = series(range === 365 ? 364 : range);
        const bars = range === 365 ? weekly(raw) : raw;
        const W = plot.clientWidth, H = W < 560 ? 200 : 260, padL = 34, padB = 26, padT = 10;
        const max = Math.max(goal * 1.25, ...bars.map((b) => b.n || 0)) * 1.05;
        const step = 5000 * Math.ceil(max / 5000 / 4);
        const y = (v) => padT + (H - padT - padB) * (1 - v / max);
        const slot = (W - padL) / bars.length, bw = Math.max(2, Math.min(28, slot * 0.62));
        let g = '';
        for (let v = 0; v <= max; v += step) g += `<line x1="${padL}" x2="${W}" y1="${y(v)}" y2="${y(v)}" class="grid"/><text x="${padL - 8}" y="${y(v) + 4}" class="ax" text-anchor="end">${v ? v / 1000 + 'k' : '0'}</text>`;
        let b = '', x = '';
        const every = range === 7 ? 1 : range === 30 ? (W < 560 ? 7 : 5) : 0;
        bars.forEach((d, i) => {
          const cx = padL + slot * i + slot / 2;
          if (d.n != null) {
            const top = y(d.n), h = Math.max(2, H - padB - top);
            b += `<rect x="${cx - bw / 2}" y="${H - padB - h}" width="${bw}" height="${h}" rx="${Math.min(4, bw / 2)}" class="b ${d.n >= goal ? 'hit' : ''}" style="--i:${i}"/>`;
          } else b += `<circle cx="${cx}" cy="${H - padB - 3}" r="1.6" class="miss"/>`;
          b += `<rect x="${padL + slot * i}" y="${padT}" width="${slot}" height="${H - padT - padB}" class="hov" data-i="${i}"/>`;
          const dt = new Date(d.k);
          const lab = range === 7 ? day(d.k, { weekday: 'short' })
            : every ? (i % every === (bars.length - 1) % every ? day(d.k, { day: 'numeric', month: 'short' }) : '')
            : (dt.getUTCDate() <= (range === 365 ? 7 : 1) && (W >= 560 || range !== 365 || dt.getUTCMonth() % 2 === 0) ? day(d.k, { month: 'short' }) : '');
          if (lab) x += `<text x="${cx}" y="${H - 6}" class="ax" text-anchor="middle">${lab}</text>`;
        });
        const gy = y(goal);
        const goalLine = `<line x1="${padL}" x2="${W}" y1="${gy}" y2="${gy}" class="goal"/><text x="${W}" y="${gy - 6}" class="gl" text-anchor="end">${fmt(goal)} goal</text>`;
        const empty = !bars.some((d) => d.n != null) ? `<text x="${(W + padL) / 2}" y="${(H - padB) / 2}" class="empty" text-anchor="middle">No steps logged in this range yet</text>` : '';
        plot.innerHTML = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="img" aria-label="Steps per ${range === 365 ? 'week (average)' : 'day'}">${g}${goalLine}${b}${x}${empty}</svg>`;

        plot.querySelectorAll('.hov').forEach((r) => {
          const d = bars[+r.dataset.i];
          const on = () => {
            plot.querySelectorAll('.b.sel').forEach((e) => e.classList.remove('sel'));
            const label = d.week ? `${day(d.k, { day: 'numeric', month: 'short' })} – ${day(d.k2, { day: 'numeric', month: 'short' })}` : day(d.k, { weekday: 'short', day: 'numeric', month: 'short' });
            tip.innerHTML = `<span>${label}</span><b>${d.n != null ? fmt(d.n) : '—'}</b><em>${d.n == null ? 'not logged' : d.week ? 'avg steps / day' : d.n >= goal ? 'goal hit ✓' : Math.round((d.n / goal) * 100) + '% of goal'}</em>`;
            tip.hidden = false;
            const px = +r.getAttribute('x') + slot / 2, tw = tip.offsetWidth;
            tip.style.left = Math.min(Math.max(px - tw / 2, 0), W - tw) + 'px';
            tip.style.top = (d.n != null ? y(d.n) : H - padB) - tip.offsetHeight - 10 + 'px';
          };
          r.addEventListener('pointerenter', on);
          r.addEventListener('click', on);
        });
        plot.onpointerleave = () => (tip.hidden = true);
        plot.querySelector('svg').addEventListener('pointerleave', () => (tip.hidden = true));

        // summary row
        const now = summary(raw), before = summary(series(range === 365 ? 364 : range, range === 365 ? 364 : range));
        const set = (k, v) => (document.querySelector(`[data-sum="${k}"]`).innerHTML = v);
        set('avg', now.got.length ? fmt(now.avg) : '—');
        set('total', now.got.length ? fmt(now.total) : '—');
        set('hit', now.got.length ? `${now.hit}<small>/${now.got.length}</small>` : '—');
        if (now.got.length && before.got.length) {
          const p = Math.round(((now.avg - before.avg) / before.avg) * 100);
          set('delta', `<span class="${p >= 0 ? 'up' : 'down'}">${p >= 0 ? '↑' : '↓'} ${Math.abs(p)}%</span>`);
        } else set('delta', '—');
        document.querySelector('[data-range-title]').textContent = range === 365 ? 'Last 12 months · weekly avg' : `Last ${range} days`;
      }

      document.querySelectorAll('[data-range]').forEach((btn) => btn.addEventListener('click', () => {
        range = +btn.dataset.range;
        document.querySelectorAll('[data-range]').forEach((b) => b.classList.toggle('on', b === btn));
        tip.hidden = true; draw();
      }));
      let t; addEventListener('resize', () => { clearTimeout(t); t = setTimeout(draw, 120); });

      const fromHash = () => { const h = location.hash.slice(1); return h.startsWith('nb-') ? 'guide' : tabs.some((t) => t.dataset.tab === h) ? h : 'steps'; };
      const go = () => { const h = location.hash.slice(1); show(fromHash()); if (h.startsWith('nb-')) document.getElementById(h)?.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
